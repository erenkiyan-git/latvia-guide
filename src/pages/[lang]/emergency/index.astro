---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import { PhoneCall, ShieldAlert, HeartPulse, Shield } from 'lucide-react';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Acil Durum İletişim Numaraları' : 'Emergency Contacts';
const pageDesc = lang === 'tr' ? 'Letonya\'daki hayati tehlike veya acil durumlar için resmi numaralar.' : 'Official numbers for life-threatening or urgent situations in Latvia.';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-rose-500 tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-slate-600">{pageDesc}</p>
    </div>

    <div class="mb-8">
      <div class="bg-surface border-2 border-rose-200 rounded-3xl p-8 sm:p-12 text-center shadow-xl shadow-rose-100/50 flex flex-col items-center">
        <div class="w-20 h-20 bg-rose-50 rounded-full flex items-center justify-center mb-6">
          <ShieldAlert class="w-10 h-10 text-rose-600" />
        </div>
        <h2 class="text-7xl font-black text-rose-600 mb-2 tracking-tighter">112</h2>
        <h3 class="text-2xl font-bold text-slate-900 mb-2">{lang === 'tr' ? 'Genel Acil Durum' : 'General Emergency'}</h3>
        <p class="text-lg text-rose-700 mb-6 font-semibold">{lang === 'tr' ? 'Ambulans, Polis, İtfaiye' : 'Ambulance, Police, Fire'}</p>
        <p class="text-sm text-slate-600 mb-8 max-w-md mx-auto">{lang === 'tr' ? 'Operatörler Letonca, Rusça ve İngilizce konuşmaktadır.' : 'Operators speak Latvian, Russian, and English.'}</p>
        <a href="tel:112" class="inline-flex items-center justify-center w-full sm:w-auto bg-primary-600 hover:bg-primary-500 text-white font-bold text-xl py-4 px-12 rounded-full transition-all shadow-lg hover:shadow-rose-500/25 hover:-translate-y-1">
          <PhoneCall class="w-6 h-6 mr-3" />
          {lang === 'tr' ? 'Hemen Ara' : 'Call Now'}
        </a>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-surface border border-slate-300 rounded-2xl p-8 text-center flex flex-col items-center">
        <HeartPulse class="w-10 h-10 text-primary-500 mb-4" />
        <h2 class="text-4xl font-extrabold text-slate-900 mb-2">66016001</h2>
        <h3 class="text-lg font-bold text-slate-700 mb-2">{lang === 'tr' ? 'Aile Hekimi Danışma Hattı' : 'Family Doctor Advisory'}</h3>
        <p class="text-sm text-slate-600 mb-8 flex-grow">{lang === 'tr' ? 'Hayati tehlike arz etmeyen tıbbi tavsiyeler için (akşamları ve hafta sonları).' : 'For non-life-threatening medical advice (evenings and weekends).'}</p>
        <a href="tel:66016001" class="inline-flex items-center justify-center w-full bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold py-3 px-6 rounded-xl transition-all">
          <PhoneCall class="w-5 h-5 mr-2 text-slate-600" />
          {lang === 'tr' ? 'Ara' : 'Call'}
        </a>
      </div>

      <div class="bg-surface border border-slate-300 rounded-2xl p-8 text-center flex flex-col items-center">
        <Shield class="w-10 h-10 text-sky-500 mb-4" />
        <h2 class="text-4xl font-extrabold text-slate-900 mb-2">110</h2>
        <h3 class="text-lg font-bold text-slate-700 mb-2">{lang === 'tr' ? 'Doğrudan Polis' : 'Direct Police'}</h3>
        <p class="text-sm text-slate-600 mb-8 flex-grow">{lang === 'tr' ? 'Doğrudan Devlet Polisine ulaşmak için (112 üzerinden de mümkündür).' : 'To reach the State Police directly (also possible via 112).'}</p>
        <a href="tel:110" class="inline-flex items-center justify-center w-full bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold py-3 px-6 rounded-xl transition-all">
          <PhoneCall class="w-5 h-5 mr-2 text-slate-600" />
          {lang === 'tr' ? 'Ara' : 'Call'}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
