---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { UsefulLinks as ReactUsefulLinks } from '../../../components/UsefulLinks';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import linksData from '../../../data/links.json';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Faydalı Web Siteleri' : 'Useful Websites';
const pageDesc = lang === 'tr' ? 'Letonya\'daki temel hizmetler ve portallar için en iyi bağlantılar.' : 'The most important links to essential services and portals in Latvia.';
const filterLabel = lang === 'tr' ? 'Sadece Resmi Kaynakları Göster' : 'Show Official Sources Only';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">{pageDesc}</p>
    </div>

    <ReactUsefulLinks client:load data={linksData} filterLabel={filterLabel} />
  </div>
</BaseLayout>
