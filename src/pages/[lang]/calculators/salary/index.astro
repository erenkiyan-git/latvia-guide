---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { NetSalaryCalculator as ReactNetSalaryCalculator } from '../../../../components/NetSalaryCalculator';
import { getActiveLanguages } from '../../../../i18n/utils';
import { useTranslations } from '../../../../i18n/utils';
import type { Lang } from '../../../../config';
import { WarningBox } from '../../../../components/ui/WarningBox';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Net Maaş Hesaplayıcı (Tahmini)' : 'Net Salary Calculator (Estimate)';
const pageDesc = lang === 'tr' ? 'Letonya vergi kesintileri sonrası aylık net maaşınızı hesaplayın.' : 'Calculate your estimated monthly net salary after Latvian tax deductions.';

const labels = {
  gross: lang === 'tr' ? 'Aylık Brüt Maaş (Bruto) - €' : 'Monthly Gross Salary (Bruto) - €',
  dependents: lang === 'tr' ? 'Kayıtlı Bakmakla Yükümlü Olunan Kişi Sayısı (Çocuklar vb.)' : 'Registered Dependents (Children, etc.)',
  estimatedDeductions: lang === 'tr' ? 'Tahmini Kesintiler' : 'Estimated Deductions',
  social: lang === 'tr' ? 'Sosyal Güvenlik (10.5%)' : 'Social Tax (VSAOI 10.5%)',
  income: lang === 'tr' ? 'Gelir Vergisi (IIN 20-23%)' : 'Income Tax (IIN 20-23%)',
  net: lang === 'tr' ? 'Net Maaşınız (Neto)' : 'Your Net Salary (Neto)'
};
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-10">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-slate-600">{pageDesc}</p>
    </div>

    <WarningBox>
      {lang === 'tr' 
        ? 'DİKKAT: Bu sadece bir tahmindir. Letonya vergi sistemi (bağımlı kişiler, engellilik durumu, yıllık gelir üzerinden değişen vergisiz asgari tutar) karmaşıktır. Resmi kesin hesaplamalar için Letonya Devlet Gelir İdaresi (VID) ile görüşün.'
        : 'DISCLAIMER: This is a simplified estimate. The Latvian tax system is complex and depends on your specific VID (State Revenue Service) non-taxable minimum, registered dependents, and other factors. For exact numbers, consult VID or your employer.'}
    </WarningBox>

    <ReactNetSalaryCalculator client:load labels={labels} />
  </div>
</BaseLayout>
