---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { LivingCostsCalculator as ReactLivingCostsCalculator } from '../../../../components/LivingCostsCalculator';
import { getActiveLanguages } from '../../../../i18n/utils';
import { useTranslations } from '../../../../i18n/utils';
import type { Lang } from '../../../../config';
import { WarningBox } from '../../../../components/ui/WarningBox';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Yaşam Maliyeti Hesaplayıcı' : 'Living Costs Calculator';
const pageDesc = lang === 'tr' 
  ? 'Riga\'da kira, faturalar, market ve ulaşım dahil aylık tahmini yaşam masraflarınızı hesaplayın.' 
  : 'Calculate your estimated monthly expenses in Riga, including rent, utilities, food, and transit.';

const labels = {
  housing: lang === 'tr' ? '🏠 Konut (Kira)' : '🏠 Housing (Rent)',
  utilities: lang === 'tr' ? '⚡ Faturalar (Elektrik, Su, Isınma)' : '⚡ Utilities (Electricity, Heating, Water)',
  food: lang === 'tr' ? '🛒 Market ve Yiyecek' : '🛒 Groceries & Food',
  transport: lang === 'tr' ? '🚌 Ulaşım (Aylık Bilet vs.)' : '🚌 Transport',
  entertainment: lang === 'tr' ? '🎉 Eğlence ve Diğer' : '🎉 Entertainment & Misc',
  total: lang === 'tr' ? 'Tahmini Toplam Maliyet' : 'Estimated Total Monthly Cost',
  hints: {
    housing: lang === 'tr' ? ['Paylaşımlı Oda', 'Lüks Daire'] : ['Shared room', 'Luxury apartment'],
    utilities: lang === 'tr' ? ['Yaz Aylarında', 'Kış (Soğuk/Eski bina)'] : ['Summer (No heating)', 'Winter (Old building)']
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-10">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-slate-600">{pageDesc}</p>
    </div>

    <WarningBox>
      {lang === 'tr' 
        ? 'DİKKAT: Bu hesaplayıcı, kullanıcı girişine dayalı kaba bir tahmindir. Fiyatlar enflasyon, konum (şehir merkezi veya banliyö) ve yaşam tarzına bağlı olarak büyük ölçüde değişir.'
        : 'DISCLAIMER: This calculator provides a rough estimate based on user input. Prices vary wildly depending on inflation, location (city center vs suburbs), and lifestyle.'}
    </WarningBox>

    <ReactLivingCostsCalculator client:load labels={labels} />
  </div>
</BaseLayout>
