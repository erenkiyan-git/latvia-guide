---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PhrasesList as ReactPhrasesList } from '../../../components/PhrasesList';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import phrasesData from '../../../data/phrases.json';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Temel Letonca İfadeler' : 'Basic Latvian Phrases';
const pageDesc = lang === 'tr' ? 'Günlük durumlar için hızlı, kopyalanabilir ifadeler ve okunuşları.' : 'Quick, copyable phrases and pronunciations for daily situations.';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-zinc-400 max-w-2xl mx-auto">{pageDesc}</p>
    </div>

    <ReactPhrasesList client:load data={phrasesData} lang={lang} />
  </div>
</BaseLayout>
