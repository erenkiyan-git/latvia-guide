---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Breadcrumbs } from '../../../../components/ui/Breadcrumbs';
import { Card } from '../../../../components/ui/Card';
import { getCollection } from 'astro:content';
import { getActiveLanguages } from '../../../../i18n/utils';
import { useTranslations } from '../../../../i18n/utils';
import type { Lang } from '../../../../config';
import { ShieldCheck, FileWarning } from 'lucide-react';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const activeLangs = getActiveLanguages();
  
  const paths: any[] = [];
  
  activeLangs.forEach(lang => {
    const langGuides = guides.filter(g => g.id.startsWith(`${lang}/`));
    const sections = [...new Set(langGuides.map(g => g.data.section))];
    
    sections.forEach(section => {
      paths.push({
        params: { lang, section },
        props: { 
          sectionGuides: langGuides.filter(g => g.data.section === section)
        }
      });
    });
  });
  
  const standardSections = ['new-to-latvia', 'students', 'work', 'housing', 'documents', 'transport', 'healthcare', 'daily-life', 'travel'];
  
  activeLangs.forEach(lang => {
    standardSections.forEach(section => {
      if (!paths.find(p => p.params.lang === lang && p.params.section === section)) {
        paths.push({
          params: { lang, section },
          props: { sectionGuides: [] }
        });
      }
    });
  });

  return paths;
}

const { lang, section } = Astro.params as { lang: Lang; section: string };
const { sectionGuides } = Astro.props;
const t = useTranslations(lang);

const formatSectionName = (name: string) => {
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};

const breadcrumbsItems = [
  { label: 'Home', href: `/${lang}/` },
  { label: 'Guides', href: `/${lang}/guides/` },
  { label: formatSectionName(section) }
];
---

<BaseLayout title={formatSectionName(section)} description={`Guides about ${formatSectionName(section).toLowerCase()} in Latvia.`} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbsItems} />

    <header class="mb-12 pb-8 border-b border-zinc-800">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">{formatSectionName(section)}</h1>
      <p class="text-zinc-400 mt-4 text-lg">Select a guide to learn more.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {sectionGuides.length > 0 ? (
        sectionGuides.map((guide: any) => {
          const [, ...slugParts] = guide.id.split('/');
          const slug = slugParts.join('/');
          
          return (
            <a href={`/${lang}/guides/${slug}/`} class="block group h-full">
              <Card hoverable className="h-full flex flex-col p-6 sm:p-8 bg-zinc-900 border-zinc-800 group-hover:bg-zinc-800/50">
                <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors pr-8 relative">
                  {guide.data.title}
                  
                  {guide.data.badge === 'official' && (
                    <div class="absolute right-0 top-1 text-emerald-500" title="Official Source">
                      <ShieldCheck class="w-5 h-5" />
                    </div>
                  )}
                  {guide.data.badge === 'verified' && (
                    <div class="absolute right-0 top-1 text-sky-500" title="Community Verified">
                      <ShieldCheck class="w-5 h-5" />
                    </div>
                  )}
                  {guide.data.badge === 'draft' && (
                    <div class="absolute right-0 top-1 text-amber-500" title="Draft">
                      <FileWarning class="w-5 h-5" />
                    </div>
                  )}
                </h3>
                <p class="text-zinc-400 text-sm leading-relaxed flex-grow">{guide.data.description}</p>
              </Card>
            </a>
          );
        })
      ) : (
        <div class="col-span-full py-16 text-center bg-zinc-900/50 rounded-2xl border border-zinc-800/50">
          <p class="text-zinc-400 text-lg">Guides for this section are being written and will appear here soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
