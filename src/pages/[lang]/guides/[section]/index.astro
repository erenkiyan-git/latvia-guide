---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Breadcrumbs } from '../../../../components/ui/Breadcrumbs';
import GuidesSidebar from '../../../../components/GuidesSidebar.astro';
import { getCollection } from 'astro:content';
import { getActiveLanguages, useTranslations, getSectionName } from '../../../../i18n/utils';
import { DEFAULT_LANG, type Lang } from '../../../../config';
import { ShieldCheck, FileWarning, Globe, Search } from 'lucide-react';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const activeLangs = getActiveLanguages();
  
  // Index guides by "lang:slug"
  const guideMap = new Map();
  guides.forEach(guide => {
    const [guideLang, ...slugParts] = guide.id.split('/');
    const slug = slugParts.join('/');
    guideMap.set(`${guideLang}:${slug}`, guide);
  });

  const enGuides = guides.filter(g => g.id.startsWith(`${DEFAULT_LANG}/`));
  const standardSections = ['new-to-latvia', 'students', 'work', 'housing', 'documents', 'transport', 'healthcare', 'daily-life', 'travel'];

  const paths: any[] = [];

  activeLangs.forEach(lang => {
    standardSections.forEach(section => {
      // Find all English guides for this section
      const sectionEnGuides = enGuides.filter(g => g.data.section === section);
      
      // For the current lang, resolve each guide (native or fallback)
      const sectionGuides = sectionEnGuides.map(enGuide => {
        const slug = enGuide.id.split('/').slice(1).join('/');
        const nativeGuide = guideMap.get(`${lang}:${slug}`);
        if (nativeGuide) {
          return { guide: nativeGuide, isFallback: false, slug };
        }
        return { guide: enGuide, isFallback: lang !== DEFAULT_LANG, slug };
      });

      // Also include any native guides for this section that don't have an EN counterpart
      guides.filter(g => g.id.startsWith(`${lang}/`) && g.data.section === section).forEach(nativeGuide => {
        const slug = nativeGuide.id.split('/').slice(1).join('/');
        if (!sectionGuides.some(item => item.slug === slug)) {
          sectionGuides.push({ guide: nativeGuide, isFallback: false, slug });
        }
      });

      paths.push({
        params: { lang, section },
        props: { sectionGuides }
      });
    });
  });

  return paths;
}

const { lang, section } = Astro.params as { lang: Lang; section: string };
const { sectionGuides } = Astro.props;
const t = useTranslations(lang);

const sectionTitle = getSectionName(section, lang);

const breadcrumbsItems = [
  { label: t('breadcrumbs.home'), href: `/${lang}/` },
  { label: t('breadcrumbs.guides'), href: `/${lang}/guides/` },
  { label: sectionTitle }
];

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://latviaguide.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbsItems.map((item, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': item.label,
    'item': item.href ? new URL(item.href, siteUrl).toString() : currentUrl
  }))
};
---

<BaseLayout title={sectionTitle} description={t('section.guidesDesc')} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
      <GuidesSidebar lang={lang} activeSection={section} />

      <div class="flex-1 min-w-0">
        <Breadcrumbs items={breadcrumbsItems} />

        <header class="mt-4 mb-6">
          <p class="hud-label mb-2">// {String(sectionGuides.length).padStart(2, '0')} {lang === 'tr' ? 'rehber' : 'guides'}</p>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">{sectionTitle}</h1>
          <p class="text-slate-600 mt-2">{t('section.selectGuide')}</p>
          <div class="hud-rule mt-5"></div>
        </header>

        <div class="relative mb-5">
          <Search class="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
          <input id="guide-filter" type="search" autocomplete="off"
            placeholder={lang === 'tr' ? 'Bu kategoride ara...' : 'Filter this category...'}
            class="w-full bg-surface border border-slate-300 rounded-lg pl-10 pr-3 py-2.5 text-sm text-slate-900 placeholder:text-slate-500 focus:outline-none focus:border-primary-500" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="guide-list">
          {sectionGuides.length > 0 ? (
            sectionGuides.map(({ guide, isFallback, slug }: any) => (
              <a href={`/${lang}/guides/${slug}/`} class="block group" data-filter={`${guide.data.title} ${guide.data.description}`.toLowerCase()}>
                <div class="hud-card hud-hover rounded-lg p-4 h-full flex flex-col">
                  <div class="flex items-start justify-between gap-2 mb-1.5">
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-primary-400 transition-colors leading-snug">{guide.data.title}</h3>
                    <div class="shrink-0 pt-0.5">
                      {guide.data.badge === 'official' && <span title="Official Source" class="text-emerald-600"><ShieldCheck class="w-4 h-4" /></span>}
                      {guide.data.badge === 'verified' && <span title="Verified" class="text-sky-600"><ShieldCheck class="w-4 h-4" /></span>}
                      {guide.data.badge === 'draft' && <span title="Draft" class="text-amber-600"><FileWarning class="w-4 h-4" /></span>}
                    </div>
                  </div>
                  <p class="text-slate-500 text-sm leading-relaxed line-clamp-2 flex-grow">{guide.data.description}</p>
                  {isFallback && (
                    <span class="mt-3 self-start inline-flex items-center gap-1 text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                      <Globe class="w-3 h-3" /> {t('section.languageNotice')}
                    </span>
                  )}
                </div>
              </a>
            ))
          ) : (
            <div class="col-span-full py-16 text-center hud-card rounded-lg">
              <p class="text-slate-600 text-lg mb-4">{t('section.empty')}</p>
              <a href={`/${lang}/guides/`} class="inline-flex items-center px-4 py-2 rounded-lg bg-primary-600 hover:bg-primary-700 text-white font-medium text-sm transition-colors">
                {t('section.allGuides')}
              </a>
            </div>
          )}

          <div id="filter-empty-state" class="col-span-full py-12 text-center hidden bg-surface border border-slate-300 rounded-xl p-6">
            <p class="text-slate-900 font-semibold mb-1">{lang === 'tr' ? 'Eşleşen rehber bulunamadı' : 'No matching guides found'}</p>
            <p class="text-xs text-slate-500 mb-4">{lang === 'tr' ? 'Farklı bir arama terimi deneyin veya filtreyi temizleyin.' : 'Try a different search term or clear the filter.'}</p>
            <button id="clear-filter-btn" type="button" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-200 hover:bg-slate-300 text-slate-800 transition-colors">
              {lang === 'tr' ? 'Filtreyi Temizle' : 'Clear Filter'}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('guide-filter');
    var emptyState = document.getElementById('filter-empty-state');
    var clearBtn = document.getElementById('clear-filter-btn');
    if (!input) return;

    function applyFilter() {
      var q = input.value.trim().toLowerCase();
      var visibleCount = 0;
      var items = document.querySelectorAll('#guide-list [data-filter]');
      items.forEach(function (el) {
        var match = !q || el.getAttribute('data-filter').indexOf(q) !== -1;
        el.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      if (emptyState) {
        emptyState.style.display = (items.length > 0 && visibleCount === 0) ? 'block' : 'none';
      }
    }

    input.addEventListener('input', applyFilter);

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        input.value = '';
        applyFilter();
        input.focus();
      });
    }
  })();
</script>
