---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getActiveLanguages } from '../../../../i18n/utils';
import { useTranslations } from '../../../../i18n/utils';
import type { Lang } from '../../../../config';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const activeLangs = getActiveLanguages();
  
  const paths: any[] = [];
  
  // Find all unique sections per active language
  activeLangs.forEach(lang => {
    const langGuides = guides.filter(g => g.id.startsWith(`${lang}/`));
    const sections = [...new Set(langGuides.map(g => g.data.section))];
    
    sections.forEach(section => {
      paths.push({
        params: { lang, section },
        props: { 
          sectionGuides: langGuides.filter(g => g.data.section === section)
        }
      });
    });
  });
  
  // Also add standard empty sections so links don't break if no guides yet
  const standardSections = ['new-to-latvia', 'students', 'work', 'housing', 'documents', 'transport', 'healthcare', 'daily-life', 'travel'];
  
  activeLangs.forEach(lang => {
    standardSections.forEach(section => {
      if (!paths.find(p => p.params.lang === lang && p.params.section === section)) {
        paths.push({
          params: { lang, section },
          props: { sectionGuides: [] }
        });
      }
    });
  });

  return paths;
}

const { lang, section } = Astro.params as { lang: Lang; section: string };
const { sectionGuides } = Astro.props;
const t = useTranslations(lang);

const formatSectionName = (name: string) => {
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
---

<BaseLayout title={formatSectionName(section)} description={`Guides about ${formatSectionName(section).toLowerCase()} in Latvia.`} lang={lang}>
  <div class="container">
    <div class="breadcrumbs">
      <a href={`/${lang}/guides/`}>All Guides</a> &rsaquo; <span>{formatSectionName(section)}</span>
    </div>

    <div class="header-section">
      <h1>{formatSectionName(section)}</h1>
    </div>

    <div class="guides-grid">
      {sectionGuides.length > 0 ? (
        sectionGuides.map((guide: any) => {
          const [, ...slugParts] = guide.id.split('/');
          const slug = slugParts.join('/');
          return (
            <a href={`/${lang}/guides/${slug}/`} class="guide-card">
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              {guide.data.badge === 'official' && <span class="card-badge">Official</span>}
              {guide.data.badge === 'verified' && <span class="card-badge verified">Verified</span>}
            </a>
          );
        })
      ) : (
        <div class="empty-state">
          <p>Guides for this section are being written and will appear here soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumbs {
    margin: var(--spacing-6) 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .breadcrumbs a {
    color: var(--color-primary);
  }

  .header-section {
    padding: var(--spacing-4) 0 var(--spacing-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-8);
  }

  .header-section h1 {
    font-size: 2.5rem;
    color: var(--color-primary-dark);
  }

  .guides-grid {
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: 1fr;
    margin-bottom: var(--spacing-16);
  }

  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  .guide-card {
    display: block;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-6);
    color: var(--color-text);
    transition: all 0.2s ease;
    position: relative;
  }

  .guide-card:hover {
    text-decoration: none;
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .guide-card h3 {
    margin-bottom: var(--spacing-2);
    color: var(--color-primary-dark);
    font-size: 1.25rem;
    padding-right: var(--spacing-12);
  }

  .guide-card p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0;
  }

  .card-badge {
    position: absolute;
    top: var(--spacing-4);
    right: var(--spacing-4);
    background-color: var(--color-success-bg);
    color: var(--color-success);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-weight: 600;
    text-transform: uppercase;
  }
  
  .card-badge.verified {
    background-color: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--spacing-12);
    background-color: var(--color-bg);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }
</style>
