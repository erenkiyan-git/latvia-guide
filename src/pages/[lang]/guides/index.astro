---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Card } from '../../../components/ui/Card';
import { getCollection } from 'astro:content';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import { ShieldCheck, FileWarning, ArrowRight } from 'lucide-react';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Get all guides for the current language
const allGuides = await getCollection('guides', (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

// Group guides by section
const sections = allGuides.reduce((acc, guide) => {
  const section = guide.data.section;
  if (!acc[section]) {
    acc[section] = [];
  }
  acc[section].push(guide);
  return acc;
}, {} as Record<string, typeof allGuides>);

// Capitalize helper
const formatSectionName = (name: string) => {
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
---

<BaseLayout title={t('nav.guides')} description="All guides for foreigners in Latvia." lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <header class="mb-16 text-center border-b border-zinc-800 pb-10">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">{t('nav.guides')}</h1>
      <p class="text-xl text-zinc-400">Browse all our practical guides by category.</p>
    </header>

    <div class="space-y-20">
      {Object.entries(sections).length > 0 ? (
        Object.entries(sections).map(([section, guides]) => (
          <section>
            <div class="flex items-center justify-between mb-8 border-b border-zinc-800/50 pb-4">
              <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                <a href={`/${lang}/guides/${section}/`} class="hover:text-primary-500 transition-colors">
                  {formatSectionName(section)}
                </a>
              </h2>
              <a href={`/${lang}/guides/${section}/`} class="hidden sm:flex items-center text-sm font-semibold text-primary-500 hover:text-primary-400 transition-colors">
                View all <ArrowRight class="w-4 h-4 ml-1" />
              </a>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {guides.map(guide => {
                const [, ...slugParts] = guide.id.split('/');
                const slug = slugParts.join('/');
                
                return (
                  <a href={`/${lang}/guides/${slug}/`} class="block group h-full">
                    <Card hoverable className="h-full flex flex-col p-6 sm:p-8 bg-zinc-900 border-zinc-800 group-hover:bg-zinc-800/50">
                      <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors pr-8 relative">
                        {guide.data.title}
                        
                        {guide.data.badge === 'official' && (
                          <div class="absolute right-0 top-1 text-emerald-500" title="Official Source">
                            <ShieldCheck class="w-5 h-5" />
                          </div>
                        )}
                        {guide.data.badge === 'verified' && (
                          <div class="absolute right-0 top-1 text-sky-500" title="Community Verified">
                            <ShieldCheck class="w-5 h-5" />
                          </div>
                        )}
                        {guide.data.badge === 'draft' && (
                          <div class="absolute right-0 top-1 text-amber-500" title="Draft">
                            <FileWarning class="w-5 h-5" />
                          </div>
                        )}
                      </h3>
                      <p class="text-zinc-400 text-sm leading-relaxed flex-grow">{guide.data.description}</p>
                    </Card>
                  </a>
                );
              })}
            </div>
            
            <a href={`/${lang}/guides/${section}/`} class="sm:hidden mt-6 flex justify-center items-center py-3 w-full border border-zinc-800 rounded-xl text-sm font-semibold text-zinc-300 hover:bg-zinc-900 hover:text-white transition-colors">
              View all {formatSectionName(section)} guides
            </a>
          </section>
        ))
      ) : (
        <div class="text-center py-16 bg-zinc-900/50 rounded-2xl border border-zinc-800/50">
          <p class="text-zinc-400 text-lg">Guides are being written and will appear here soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
