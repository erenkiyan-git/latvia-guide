---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidesSidebar from '../../../components/GuidesSidebar.astro';
import { getCollection } from 'astro:content';
import { getActiveLanguages, useTranslations, getSectionName } from '../../../i18n/utils';
import { DEFAULT_LANG, type Lang } from '../../../config';
import { ArrowRight, Globe, MapPin, FileText, Briefcase, Home, GraduationCap, Stethoscope, Bus, Coffee, Compass } from 'lucide-react';

const ICONS: Record<string, any> = {
  'new-to-latvia': MapPin, documents: FileText, work: Briefcase, housing: Home, students: GraduationCap,
  healthcare: Stethoscope, transport: Bus, 'daily-life': Coffee, travel: Compass
};

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allGuides = await getCollection('guides');

// Index guides by "lang:slug"
const guideMap = new Map();
allGuides.forEach(guide => {
  const [guideLang, ...slugParts] = guide.id.split('/');
  const slug = slugParts.join('/');
  guideMap.set(`${guideLang}:${slug}`, guide);
});

const enGuides = allGuides.filter(g => g.id.startsWith(`${DEFAULT_LANG}/`));
const standardSections = ['new-to-latvia', 'documents', 'work', 'housing', 'students', 'healthcare', 'transport', 'daily-life', 'travel'];

// Build section entries with native or fallback guides
const sections = standardSections.map(section => {
  const sectionEnGuides = enGuides.filter(g => g.data.section === section);
  
  const sectionGuides = sectionEnGuides.map(enGuide => {
    const slug = enGuide.id.split('/').slice(1).join('/');
    const nativeGuide = guideMap.get(`${lang}:${slug}`);
    if (nativeGuide) {
      return { guide: nativeGuide, isFallback: false, slug };
    }
    return { guide: enGuide, isFallback: lang !== DEFAULT_LANG, slug };
  });

  // Native guides without EN counterpart
  allGuides.filter(g => g.id.startsWith(`${lang}/`) && g.data.section === section).forEach(nativeGuide => {
    const slug = nativeGuide.id.split('/').slice(1).join('/');
    if (!sectionGuides.some(item => item.slug === slug)) {
      sectionGuides.push({ guide: nativeGuide, isFallback: false, slug });
    }
  });

  return {
    section,
    title: getSectionName(section, lang),
    guides: sectionGuides
  };
}).filter(sec => sec.guides.length > 0);
---

<BaseLayout title={t('nav.guides')} description={t('guides.subtitle')} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
      <GuidesSidebar lang={lang} />

      <div class="flex-1 min-w-0">
        <header class="mb-8">
          <p class="hud-label mb-2">// {lang === 'tr' ? 'Rehber Merkezi' : 'Guide Hub'}</p>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">{t('nav.guides')}</h1>
          <p class="text-slate-600">{t('guides.subtitle')}</p>
          <div class="hud-rule mt-5"></div>
        </header>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
          {sections.map(({ section, title, guides }) => {
            const Icon = ICONS[section];
            return (
              <section class="hud-card rounded-lg p-5 flex flex-col">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <a href={`/${lang}/guides/${section}/`} class="flex items-center gap-3 group min-w-0">
                    <span class="flex items-center justify-center w-9 h-9 rounded-md bg-primary-50 border border-primary-200 text-primary-400 shrink-0">
                      <Icon class="w-4.5 h-4.5" />
                    </span>
                    <h2 class="text-lg font-bold text-slate-900 group-hover:text-primary-400 transition-colors truncate">{title}</h2>
                  </a>
                  <span class="font-mono text-xs text-slate-500 shrink-0">{String(guides.length).padStart(2, '0')}</span>
                </div>

                <ul class="space-y-0.5 flex-1">
                  {guides.slice(0, 4).map(({ guide, isFallback, slug }) => (
                    <li>
                      <a href={`/${lang}/guides/${slug}/`} class="flex items-center gap-2 px-2 py-1.5 -mx-2 rounded-md text-sm text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">
                        <span class="text-primary-500 font-mono text-xs">&gt;</span>
                        <span class="truncate flex-1">{guide.data.title}</span>
                        {isFallback && <Globe class="w-3 h-3 text-amber-600 shrink-0" aria-label={t('section.languageNotice')} />}
                      </a>
                    </li>
                  ))}
                </ul>

                <a href={`/${lang}/guides/${section}/`} class="mt-4 pt-3 border-t border-slate-200 flex items-center text-sm font-semibold text-primary-400 hover:text-primary-300 transition-colors">
                  {t('section.viewAll')} ({guides.length}) <ArrowRight class="w-4 h-4 ml-1" />
                </a>
              </section>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

