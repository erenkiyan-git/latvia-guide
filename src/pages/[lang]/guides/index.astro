---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Get all guides for the current language
const allGuides = await getCollection('guides', (entry) => {
  return entry.id.startsWith(`${lang}/`);
});

// Group guides by section
const sections = allGuides.reduce((acc, guide) => {
  const section = guide.data.section;
  if (!acc[section]) {
    acc[section] = [];
  }
  acc[section].push(guide);
  return acc;
}, {} as Record<string, typeof allGuides>);

// Capitalize helper
const formatSectionName = (name: string) => {
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
---

<BaseLayout title={t('nav.guides')} description="All guides for foreigners in Latvia." lang={lang}>
  <div class="container">
    <div class="header-section">
      <h1>{t('nav.guides')}</h1>
      <p class="subtitle">Browse all our practical guides by category.</p>
    </div>

    <div class="sections-container">
      {Object.entries(sections).length > 0 ? (
        Object.entries(sections).map(([section, guides]) => (
          <section class="guide-section">
            <h2 class="section-title">
              <a href={`/${lang}/guides/${section}/`} class="section-link">{formatSectionName(section)}</a>
            </h2>
            <div class="guides-grid">
              {guides.map(guide => {
                const [, ...slugParts] = guide.id.split('/');
                const slug = slugParts.join('/');
                return (
                  <a href={`/${lang}/guides/${slug}/`} class="guide-card">
                    <h3>{guide.data.title}</h3>
                    <p>{guide.data.description}</p>
                    {guide.data.badge === 'official' && <span class="card-badge">Official</span>}
                  </a>
                );
              })}
            </div>
          </section>
        ))
      ) : (
        <div class="empty-state">
          <p>Guides are being written and will appear here soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .header-section {
    padding: var(--spacing-8) 0;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-8);
  }

  .header-section h1 {
    font-size: 2.5rem;
    color: var(--color-primary-dark);
  }

  .guide-section {
    margin-bottom: var(--spacing-12);
  }

  .section-title {
    margin-bottom: var(--spacing-6);
  }

  .section-link {
    color: var(--color-text);
  }

  .section-link:hover {
    color: var(--color-primary);
  }

  .guides-grid {
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }

  .guide-card {
    display: block;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-6);
    color: var(--color-text);
    transition: all 0.2s ease;
    position: relative;
  }

  .guide-card:hover {
    text-decoration: none;
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .guide-card h3 {
    margin-bottom: var(--spacing-2);
    color: var(--color-primary-dark);
    font-size: 1.25rem;
  }

  .guide-card p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0;
  }

  .card-badge {
    position: absolute;
    top: var(--spacing-2);
    right: var(--spacing-2);
    background-color: var(--color-success-bg);
    color: var(--color-success);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-weight: 600;
    text-transform: uppercase;
  }

  .empty-state {
    text-align: center;
    padding: var(--spacing-12);
    background-color: var(--color-bg);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }
</style>
