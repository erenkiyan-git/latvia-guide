---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Checklist as ReactChecklist } from '../../../components/Checklist';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import checklistData from '../../../data/checklist.json';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// @ts-ignore - indexing JSON safely
const groups = checklistData[lang] || checklistData['en'];

const pageTitle = lang === 'tr' ? 'Yeni Gelenler İçin 30 Günlük Kontrol Listesi' : 'New to Latvia: 30-Day Checklist';
const pageDesc = lang === 'tr' 
  ? 'Letonya\'ya taşınmanızın ilk 30 gününde tamamlamanız gereken resmi işlemler ve pratik kontrol listesi.' 
  : 'Your step-by-step practical checklist for all essential tasks during your first 30 days in Latvia.';
const resetText = lang === 'tr' ? 'İlerlemeyi Sıfırla' : 'Reset Progress';
const printText = lang === 'tr' ? 'Listeyi Yazdır' : 'Print Checklist';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <ReactChecklist 
      client:only="react"
      groups={groups} 
      pageTitle={pageTitle} 
      pageDesc={pageDesc} 
      resetText={resetText} 
      printText={printText}
      lang={lang} 
    />
  </div>
</BaseLayout>
