---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getActiveLanguages } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import { SITE } from '../../../config';
import { TrustBadge } from '../../../components/ui/TrustBadge';
import { Button } from '../../../components/ui/Button';
import { ShieldCheck, ShieldAlert, FileWarning, Search, Eye, AlertTriangle } from 'lucide-react';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = lang === 'tr' ? 'Hakkımızda & Bilgi Güveni' : 'About & Information Trust';
const pageDesc = lang === 'tr' ? 'Latvia Guide nasıl çalışır ve bilgileri nasıl doğruluyoruz.' : 'How Latvia Guide works and how we verify our information.';
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <picture>
      <source srcset="/social-card.webp" type="image/webp" />
      <img 
        src="/social-card.jpg" 
        alt="Latvia Guide" 
        width="1376" 
        height="768" 
        class="w-full rounded-xl border border-slate-300 mb-10 opacity-95" 
        loading="lazy" 
        decoding="async" 
      />
    </picture>
    <div class="text-center mb-10">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">{pageTitle}</h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">{pageDesc}</p>
    </div>

    {/* Prominent Independence Notice */}
    <div class="my-8 p-5 sm:p-6 rounded-2xl bg-amber-950/20 border border-amber-500/40 text-amber-200 flex items-start gap-4 shadow-sm not-prose">
      <AlertTriangle class="w-6 h-6 text-amber-400 shrink-0 mt-0.5" />
      <div class="text-sm leading-relaxed">
        <h2 class="font-bold text-amber-300 text-base mb-1">
          {lang === 'tr' ? 'Resmi Bağımsızlık Bildirimi' : 'Independence Notice'}
        </h2>
        <p class="text-slate-700 m-0">
          {lang === 'tr'
            ? 'Latvia Guide bağımsız bir bilgilendirme projesidir ve Letonya Cumhuriyeti resmi devlet kurumu veya web sitesi değildir. Tüm resmi başvurular doğrudan ilgili devlet makamlarına (PMLP, VID, NVD vb.) yapılmalıdır.'
            : 'Latvia Guide is an independent informational project and is not an official government website of the Republic of Latvia. All official applications, appointments, and legal filings must be completed directly with the competent state authorities (PMLP, VID, NVD, etc.).'}
        </p>
      </div>
    </div>

    <div class="prose prose-slate max-w-none 
      prose-headings:text-slate-900 prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-6 prose-h2:border-b border-slate-300 prose-h2:pb-4
      prose-p:text-slate-700 prose-p:leading-relaxed prose-p:mb-6 prose-p:text-lg">
      
      <h2>{lang === 'tr' ? 'Kuruluş Hikayemiz' : 'Why We Built Latvia Guide'}</h2>
      <p class="lead text-xl text-slate-700">
        {lang === 'tr' 
          ? 'Letonya\'ya ilk taşındığımızda hissettiğimiz şeyi çok iyi biliyoruz: yüzlerce farklı resmi portal, çelişkili forum tavsiyeleri, dil bariyeri ve bilinmezlik.'
          : 'When moving to Latvia for the first time, almost every foreigner encounters the same wall: dozens of fragmented government portals, outdated forum posts, conflicting advice, and unfamiliar bureaucratic terminology.'
        }
      </p>

      <div class="my-8 p-6 sm:p-8 rounded-2xl bg-surface border border-slate-300 shadow-sm not-prose">
        <h3 class="text-xl font-bold text-slate-900 mb-3">
          {lang === 'tr' ? 'Yabancılar İçin, Yabancılar Tarafından' : 'Built in Riga for Foreigners, by Foreigners'}
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
          {lang === 'tr'
            ? 'PMLP randevusu almaktan ikametgah beyanına (deklarēšanās), EDS vergi kitapçığı onayından güvenilir ev bulmaya kadar her adımda "keşke elimizde tek bir derli toplu rehber olsaydı" dedik. Latvia Guide, bu eksikliği gidermek için kuruldu.'
            : 'From booking PMLP biometrics appointments to declaring an address (deklarēšanās), registering your tax booklet on VID EDS, and avoiding apartment scams in Old Town, we wanted the single verified handbook we desperately needed on Day 1.'}
        </p>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed m-0">
          {lang === 'tr'
            ? 'Bu rehber kar amaçlı bir reklam platformu değil, tamamen bağımsız, çerezsiz (100% cookieless) ve kullanıcı gizliliğine saygılı bir kamu faydası projesidir.'
            : 'This site is not an advertising farm. It is a 100% cookieless, privacy-first, community-driven handbook designed to help international students, digital nomads, workers, and new residents thrive in Latvia.'}
        </p>
      </div>

      <h2>{lang === 'tr' ? 'Bilgilere Neden Güvenmelisiniz?' : 'Why Trust Our Information?'}</h2>
      <p>
        {lang === 'tr' 
          ? 'İnternetteki çoğu blogun aksine, asla vergi oranlarını, vize kurallarını veya para cezalarını tahmin etmiyoruz veya uydurmuyoruz. Katı bir editoryal sürecimiz var:'
          : 'Unlike most blogs on the internet, we never guess or invent tax rates, visa rules, or fines. We have a strict editorial process:'
        }
      </p>
      
      <div class="grid sm:grid-cols-3 gap-6 my-10 not-prose">
        <div class="bg-surface border border-slate-300 p-6 rounded-2xl">
          <Search class="w-8 h-8 text-primary-500 mb-4" />
          <h3 class="text-slate-900 font-bold text-lg mb-2">{lang === 'tr' ? 'Resmi Kaynaklar' : 'Official Sources'}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{lang === 'tr' ? 'Her rehberdeki her önemli iddia (PMLP, VID vb.) doğrudan resmi hükümet bağlantılarına dayandırılır.' : 'Every major claim in our guides is backed by direct links to official government sources.'}</p>
        </div>
        <div class="bg-surface border border-slate-300 p-6 rounded-2xl">
          <Eye class="w-8 h-8 text-primary-500 mb-4" />
          <h3 class="text-slate-900 font-bold text-lg mb-2">{lang === 'tr' ? 'Son Kontrol Tarihi' : 'Human Verified'}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{lang === 'tr' ? 'Tüm rehberlerimiz, bilginin bir insan tarafından en son ne zaman resmi olarak doğrulandığını gösteren bir "Son kontrol" tarihi içerir.' : 'All our guides include a "Last checked" date, so you know exactly when a human last verified the information.'}</p>
        </div>
        <div class="bg-surface border border-slate-300 p-6 rounded-2xl">
          <AlertTriangle class="w-8 h-8 text-primary-500 mb-4" />
          <h3 class="text-slate-900 font-bold text-lg mb-2">{lang === 'tr' ? 'Yapay Zeka Halüsinasyonu Yok' : 'No Hallucinations'}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{lang === 'tr' ? 'Doğrulanmamış AI üretimi bilgilerin platformumuza girmesine izin vermiyoruz.' : 'We do not allow unverified AI-generated information to enter our platform.'}</p>
        </div>
      </div>

      <h2>{lang === 'tr' ? 'Rozet Sistemimiz' : 'Our Badge System'}</h2>
      
      <div class="space-y-6 my-10 not-prose">
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-start sm:items-center bg-surface p-6 rounded-2xl border border-slate-300">
          <div class="flex-shrink-0">
            <TrustBadge type="official" />
          </div>
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed m-0">
            {lang === 'tr' ? 'Bu bilgi, Letonya hükümetinin resmi belgelerine veya kurumlarına dayanmaktadır.' : 'This information is based strictly on official Latvian government documentation or institutions.'}
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-start sm:items-center bg-surface p-6 rounded-2xl border border-slate-300">
          <div class="flex-shrink-0">
            <TrustBadge type="verified" />
          </div>
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed m-0">
            {lang === 'tr' ? 'Bu bilgi, Letonya\'da yaşayan yerel uzmanlar veya yabancılar tarafından pratik olarak doğrulanmıştır (örneğin, ev arama ipuçları).' : 'This information has been practically verified by local experts or expats living in Latvia (e.g., apartment hunting tips).'}
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-start sm:items-center bg-surface p-6 rounded-2xl border border-slate-300">
          <div class="flex-shrink-0">
            <TrustBadge type="draft" />
          </div>
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed m-0">
            {lang === 'tr' ? 'Bu içerik henüz uzmanlarımız tarafından tam olarak doğrulanmamıştır. Lütfen resmi kaynakları kendiniz kontrol edin.' : 'This content has not yet been fully verified by our experts. Please double-check official sources yourself.'}
          </p>
        </div>
      </div>
      
      <div class="mt-16 bg-surface border-2 border-primary-200 p-10 rounded-3xl text-center shadow-xs not-prose">
        <h3 class="text-2xl font-bold text-slate-900 mb-4">{lang === 'tr' ? 'Bir Hata mı Gördünüz?' : 'Spotted an Error?'}</h3>
        <p class="text-slate-600 text-lg mb-8 max-w-lg mx-auto">
          {lang === 'tr' ? 'Kurallar sürekli değişir. Eski bir bilgi bulursanız, lütfen bize bildirin.' : 'Rules change constantly. If you find outdated information, please let us know.'}
        </p>
        <Button href={`mailto:${SITE.contactEmail}`} size="lg" className="px-8">
          {lang === 'tr' ? 'Bize Ulaşın' : 'Contact Us'}
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
