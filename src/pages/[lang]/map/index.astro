---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getActiveLanguages, useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import { Map as MapIcon, WifiOff, ExternalLink } from 'lucide-react';
import InteractiveMap from '../../../components/ui/InteractiveMap';
import { getLocators } from '../../../lib/places';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = t('map.title');
const pageDesc = t('map.intro');
const locators = getLocators();

// Pick helper for Astro side
function p(val: any, l: string) {
  if (!val) return '';
  return val[l] || val.en;
}
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3 flex items-center">
        <MapIcon class="w-8 h-8 text-primary-500 mr-3 hidden sm:block" />
        {pageTitle}
      </h1>
      <p class="text-lg text-zinc-400 max-w-3xl">
        {pageDesc}
      </p>
      <p class="text-sm text-zinc-500 mt-2 flex items-start sm:items-center">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-2 mt-1 sm:mt-0 shrink-0"></span>
        {t('map.changeNote')}
      </p>
    </div>

    {/* The Interactive Map (React) */}
    <div class="mb-12">
      <noscript>
        <div class="bg-zinc-900 border border-amber-900/50 rounded-xl p-6 mb-6 text-amber-200">
          <p class="font-medium mb-2">{t('map.noJs')}</p>
        </div>
      </noscript>
      
      <InteractiveMap client:only="react" lang={lang} t={t} />
      
      {/* Fallback list for no-JS and SEO. Hidden if JS loads successfully. */}
      <div id="no-js-list" class="mt-8 space-y-4">
        {/* We keep it simple in HTML, the React component replaces this visually if JS runs */}
      </div>
      
      {/* Script to inject Leaflet so it's not in the main bundle, and hide the fallback list */}
      <script is:inline>
        document.getElementById('no-js-list').style.display = 'none';
        
        // Load Leaflet JS and CSS on demand
        if (!window.L) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(link);

          const script = document.createElement('script');
          script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          document.head.appendChild(script);
        }
      </script>
    </div>

    {/* Offline tip */}
    <div class="bg-zinc-900/50 border border-zinc-800 rounded-xl p-5 mb-12 flex items-start">
      <WifiOff class="w-5 h-5 text-zinc-500 mr-3 shrink-0 mt-0.5" />
      <div>
        <h3 class="text-white font-medium text-sm mb-1">{t('map.offlineTitle')}</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">{t('map.offlineTip')}</p>
      </div>
    </div>

    {/* Locators section */}
    {locators.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold text-white mb-3">{t('map.locatorsTitle')}</h2>
        <p class="text-zinc-400 mb-6 max-w-2xl">{t('map.locatorsIntro')}</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {locators.map(loc => (
            <a 
              href={loc.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-zinc-700 hover:bg-zinc-800/50 transition-colors group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold px-2 py-1 rounded-md text-zinc-400 bg-zinc-950 border border-zinc-800">
                  {t(`map.cat.${loc.category}`)}
                </span>
                <ExternalLink class="w-4 h-4 text-zinc-600 group-hover:text-primary-400 transition-colors" />
              </div>
              <h3 class="text-lg font-bold text-white mb-1 group-hover:text-primary-400 transition-colors">{loc.name}</h3>
              <p class="text-sm text-zinc-400">{p(loc.description, lang)}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
