---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getActiveLanguages, useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../config';
import { Map as MapIcon, WifiOff, ExternalLink } from 'lucide-react';
import InteractiveMap from '../../../components/ui/InteractiveMap';
import { getLocators } from '../../../lib/places';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const pageTitle = t('map.title');
const pageDesc = t('map.intro');
const locators = getLocators();

// Pick helper for Astro side
function p(val: any, l: string) {
  if (!val) return '';
  return val[l] || val.en;
}

const dict: Record<string, string> = {};
const keys = [
  'map.viewList', 'map.viewMap', 'map.searchPlaceholder', 'map.showAll',
  'map.resultsCount', 'map.nearMeLocating', 'map.nearMeActive', 'map.nearMe',
  'map.nearMeDenied', 'map.noResults', 'map.reset', 'map.officialWebsite',
  'map.directions', 'map.officialSource', 'map.lastChecked', 'map.loadError',
  'map.cat.hospital', 'map.cat.transport', 'map.cat.university',
  'map.cat.immigration', 'map.cat.attraction', 'map.cat.pharmacy',
  'map.cat.bank', 'map.cat.supermarket', 'map.cat.tickets', 'map.cat.government',
  'map.cat.embassy'
];
keys.forEach(k => {
  dict[k] = t(k);
});
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3 flex items-center">
        <MapIcon class="w-8 h-8 text-primary-500 mr-3 hidden sm:block" />
        {pageTitle}
      </h1>
      <p class="text-lg text-slate-600 max-w-3xl">
        {pageDesc}
      </p>
      <p class="text-sm text-slate-500 mt-2 flex items-start sm:items-center">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-2 mt-1 sm:mt-0 shrink-0"></span>
        {t('map.changeNote')}
      </p>
    </div>

    {/* The Interactive Map (React) */}
    <div class="mb-12">
      <noscript>
        <div class="bg-white border border-amber-900/50 rounded-xl p-6 mb-6 text-amber-200">
          <p class="font-medium mb-2">{t('map.noJs')}</p>
        </div>
      </noscript>
      
      <InteractiveMap client:only="react" lang={lang} dict={dict} />
      
      {/* Fallback list for no-JS and SEO. Hidden if JS loads successfully. */}
      <div id="no-js-list" class="mt-8 space-y-4">
        {/* We keep it simple in HTML, the React component replaces this visually if JS runs */}
      </div>
      
      {/* Script to inject Leaflet so it's not in the main bundle, and hide the fallback list */}
      <script is:inline>
        document.getElementById('no-js-list').style.display = 'none';
        
        // Load Leaflet JS and CSS on demand
        if (!window.L) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(link);

          const script = document.createElement('script');
          script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          document.head.appendChild(script);
        }
      </script>
    </div>

    {/* Offline tip */}
    <div class="bg-white/50 border border-slate-300 rounded-xl p-5 mb-12 flex items-start">
      <WifiOff class="w-5 h-5 text-slate-500 mr-3 shrink-0 mt-0.5" />
      <div>
        <h3 class="text-slate-900 font-medium text-sm mb-1">{t('map.offlineTitle')}</h3>
        <p class="text-slate-600 text-sm leading-relaxed">{t('map.offlineTip')}</p>
      </div>
    </div>

    {/* Locators section */}
    {locators.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">{t('map.locatorsTitle')}</h2>
        <p class="text-slate-600 mb-6 max-w-2xl">{t('map.locatorsIntro')}</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {locators.map(loc => (
            <a 
              href={loc.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block bg-white border border-slate-300 rounded-xl p-5 hover:border-slate-300 hover:bg-slate-100/50 transition-colors group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold px-2 py-1 rounded-md text-slate-600 bg-slate-50 border border-slate-300">
                  {t(`map.cat.${loc.category}`)}
                </span>
                <ExternalLink class="w-4 h-4 text-slate-400 group-hover:text-primary-400 transition-colors" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-primary-400 transition-colors">{loc.name}</h3>
              <p class="text-sm text-slate-600">{p(loc.description, lang)}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
