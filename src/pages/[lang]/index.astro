---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import { ProblemGrid } from '../../components/home/ProblemGrid';
import { ChecklistPreview } from '../../components/home/ChecklistPreview';
import { TrustSection } from '../../components/home/TrustSection';
import { Tag } from '../../components/ui/Tag';
import { getActiveLanguages } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../config';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Generate translations object for ProblemGrid
const problemTranslations = {
  'home.problem.arrived': t('home.problem.arrived'),
  'home.problem.housing': t('home.problem.housing'),
  'home.problem.doctor': t('home.problem.doctor'),
  'home.problem.job': t('home.problem.job'),
  'home.problem.student': t('home.problem.student'),
  'home.problem.permit': t('home.problem.permit'),
  'home.problem.transport': t('home.problem.transport'),
  'home.problem.emergency': t('home.problem.emergency'),
};
---

<BaseLayout title={t('hero.title')} description={t('hero.subtitle')} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Hero Section */}
    <section class="py-20 md:py-32 text-center relative">
      {/* Decorative background glow */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl h-64 bg-primary-900/20 blur-[100px] rounded-full pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight">
          {t('hero.title')}
        </h1>
        <p class="text-lg sm:text-xl text-zinc-400 mb-12 max-w-2xl mx-auto leading-relaxed">
          {t('hero.subtitle')}
        </p>
        
        <div class="max-w-xl mx-auto">
          <SearchBox />
        </div>
      </div>
    </section>

    {/* What do you need help with? */}
    <section class="py-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">What do you need help with?</h2>
        <p class="text-zinc-400">Select a topic to find guides and practical information.</p>
      </div>
      <ProblemGrid lang={lang} translations={problemTranslations} />
    </section>

    {/* Who are you? */}
    <section class="py-16 text-center">
      <h2 class="text-2xl font-bold text-white mb-8">{t('home.who.title')}</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <Tag href={`/${lang}/guides/students/`}>{t('home.who.student')}</Tag>
        <Tag href={`/${lang}/guides/work/`}>{t('home.who.worker')}</Tag>
        <Tag href={`/${lang}/guides/travel/`}>{t('home.who.tourist')}</Tag>
        <Tag href={`/${lang}/guides/new-to-latvia/`}>{t('home.who.resident')}</Tag>
        <Tag href={`/${lang}/guides/work/`}>{t('home.who.nomad')}</Tag>
      </div>
    </section>

    {/* 30-Day Checklist Preview */}
    <section class="py-16">
      <ChecklistPreview 
        lang={lang} 
        title="New to Latvia Checklist" 
        subtitle="A step-by-step guide for your first 30 days." 
        buttonText="View Checklist" 
      />
    </section>

    {/* Trust Section */}
    <section class="py-16 mb-10">
      <TrustSection title={t('home.trust.title')} description={t('home.trust.desc')} />
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* Ensure SearchBox is styled appropriately for dark theme until we convert it to React */
  .search-input {
    width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 9999px;
    background-color: #18181b; /* zinc-900 */
    border: 1px solid #27272a; /* zinc-800 */
    color: white;
    font-size: 1.125rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease;
  }
  
  .search-input:focus {
    outline: none;
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 3px rgba(158, 48, 57, 0.3); /* primary-700 w/ opacity */
  }
  
  .search-input::placeholder {
    color: #a1a1aa; /* zinc-400 */
  }
</style>
