---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SearchBox } from '../../components/SearchBox';
import { ProblemGrid } from '../../components/home/ProblemGrid';
import { ChecklistPreview } from '../../components/home/ChecklistPreview';
import { TrustSection } from '../../components/home/TrustSection';
import { Tag } from '../../components/ui/Tag';
import { AuseklisSymbol, LatvianSymbolBand, LatvianCultureStrip } from '../../components/ui/LatvianSymbols';
import { getActiveLanguages } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../config';

export function getStaticPaths() {
  const langs = getActiveLanguages();
  return langs.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Generate translations object for ProblemGrid
const problemTranslations = {
  'home.problem.arrived': t('home.problem.arrived'),
  'home.problem.housing': t('home.problem.housing'),
  'home.problem.doctor': t('home.problem.doctor'),
  'home.problem.job': t('home.problem.job'),
  'home.problem.student': t('home.problem.student'),
  'home.problem.permit': t('home.problem.permit'),
  'home.problem.transport': t('home.problem.transport'),
  'home.problem.emergency': t('home.problem.emergency'),
};
---

<BaseLayout title={t('hero.title')} description={t('hero.subtitle')} lang={lang}>
  {/* Full-width Hero Section: extends upward to tuck under the frosted navbar with zero horizontal overflow */}
  <section class="relative -mt-8 w-full mb-10 sm:mb-12 py-14 sm:py-24 md:py-32 text-center border-b border-slate-300">
    {/* Background Image Container with overflow hidden */}
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <img 
        src="/hero-riga.jpg" 
        alt="Riga Skyline" 
        fetchpriority="high" 
        class="w-full h-full object-cover object-center sm:object-bottom opacity-90 scale-105 filter brightness-95 contrast-110" 
      />
      {/* Dynamic gradient overlay to ensure readable text while keeping the Riga spires vibrant */}
      <div class="absolute inset-0 bg-gradient-to-b from-base/80 via-base/40 to-base/95"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-base to-transparent"></div>
    </div>

    {/* Content Container - overflow visible so SearchBox dropdown can float unobstructed */}
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1 rounded-full bg-surface/90 border border-primary-500/40 text-primary-400 mb-5 sm:mb-6 shadow-md backdrop-blur max-w-full">
        <AuseklisSymbol size={16} className="text-primary-400 shrink-0" />
        <span class="text-[0.68rem] sm:text-xs font-mono tracking-wider sm:tracking-widest uppercase truncate">
          Riga · Latvia · {lang === 'tr' ? 'Rehber & Göçmen Portalı' : 'Practical Guide for Newcomers'}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 mb-4 sm:mb-6 tracking-tight leading-tight drop-shadow-md">
        {t('hero.title')}
      </h1>
      
      <p class="text-base sm:text-xl text-slate-700 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed font-normal">
        {t('hero.subtitle')}
      </p>
      
      {/* Wide Search Container */}
      <div class="max-w-2xl sm:max-w-3xl mx-auto relative z-30">
        <SearchBox client:load lang={lang} placeholder={t('hero.search')} />
      </div>

      {/* Smooth Scroll Button to Help Section */}
      <div class="mt-10 sm:mt-16">
        <a 
          href="#help-section" 
          class="inline-flex flex-col items-center gap-1.5 text-slate-600 hover:text-primary-300 transition-colors group cursor-pointer focus:outline-none"
          aria-label={lang === 'tr' ? 'Yardım konularına kaydır' : 'Scroll to help topics'}
        >
          <span class="text-xs font-mono uppercase tracking-widest text-slate-500 group-hover:text-primary-300 transition-all font-semibold">
            {lang === 'tr' ? 'Keşfet' : 'Explore'}
          </span>
          <div class="w-8 h-8 rounded-full border border-slate-300 group-hover:border-primary-500 flex items-center justify-center bg-base/80 backdrop-blur group-hover:bg-primary-950/60 transition-all animate-bounce shadow-md">
            <svg class="w-4 h-4 text-primary-400 group-hover:text-primary-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* Main Content Container */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Traditional Latvian Sacred Symbols Ribbon */}
    <LatvianSymbolBand className="my-6" />

    {/* What do you need help with? */}
    <section id="help-section" class="py-10 sm:py-16 scroll-mt-20 sm:scroll-mt-24">
      <div class="text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 mb-3 sm:mb-4">{t('home.help.title')}</h2>
        <p class="text-slate-700 text-base sm:text-lg max-w-2xl mx-auto">{t('home.help.subtitle')}</p>
      </div>
      <ProblemGrid lang={lang} translations={problemTranslations} />
    </section>

    {/* Cultural Symbols Explanation Strip */}
    <LatvianCultureStrip lang={lang} />

    {/* Who are you? */}
    <section class="py-16 text-center border-t border-slate-300/60">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">{t('home.who.title')}</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <Tag href={`/${lang}/guides/students/`}>{t('home.who.student')}</Tag>
        <Tag href={`/${lang}/guides/work/`}>{t('home.who.worker')}</Tag>
        <Tag href={`/${lang}/guides/travel/`}>{t('home.who.tourist')}</Tag>
        <Tag href={`/${lang}/guides/new-to-latvia/`}>{t('home.who.resident')}</Tag>
        <Tag href={`/${lang}/guides/work/`}>{t('home.who.nomad')}</Tag>
      </div>
    </section>

    {/* 30-Day Checklist Preview */}
    <section class="py-16">
      <ChecklistPreview 
        lang={lang} 
        title={t('home.checklist.title')} 
        subtitle={t('home.checklist.subtitle')} 
        buttonText={t('home.checklist.button')} 
      />
    </section>

    {/* Trust Section */}
    <section class="py-16 mb-10">
      <TrustSection title={t('home.trust.title')} description={t('home.trust.desc')} />
    </section>
  </div>
</BaseLayout>
