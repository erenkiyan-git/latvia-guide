---
// Root entry point: intelligently redirect based on user preference or browser language
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Latvia Guide</title>
    <script is:inline>
      try {
        var saved = localStorage.getItem('preferred_lang');
        var browserLang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        var isTurkish = browserLang.toLowerCase().indexOf('tr') === 0;
        var target = saved || (isTurkish ? 'tr' : 'en');
        window.location.replace('/' + target + '/');
      } catch (e) {
        window.location.replace('/en/');
      }
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
  <body style="background:#EDEFF2;">
  </body>
</html>
