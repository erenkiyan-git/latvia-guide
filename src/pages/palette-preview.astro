---
// Minimal layout for the palette preview page
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Palette Preview</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-300 p-8 font-sans text-[#2A3039]">

  <div class="max-w-6xl mx-auto space-y-16">
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-2">Latvia Guide - Palette Previews</h1>
      <p class="text-gray-700">Compare the 3 options showing the revised gray canvas.</p>
    </div>

    <!-- OPTION A -->
    <div class="rounded-xl overflow-hidden shadow-2xl border-4 border-slate-400">
      <div class="bg-slate-800 text-white p-3 font-bold text-center text-lg">Option A: Gray + Authentic Carmine</div>
      
      <div class="bg-[#EDEFF2]">
        <!-- Header -->
        <header class="bg-white border-b border-[#C9CFD7] px-6 py-4 flex justify-between items-center">
          <div class="font-bold text-xl tracking-tight text-[#1B2027]">Latvia Guide</div>
          <nav class="space-x-4 text-sm font-medium text-[#5A6370]">
            <a href="#" class="text-[#9E3039]">Guides</a>
            <a href="#" class="hover:text-[#1B2027]">Map</a>
          </nav>
        </header>

        <!-- Hero -->
        <section class="bg-[#E1E5EA] border-b border-[#C9CFD7] px-6 py-16 text-center">
          <h2 class="text-4xl font-extrabold mb-4 text-[#1B2027]">Your Guide to Latvia</h2>
          <p class="text-[#5A6370] max-w-2xl mx-auto mb-8 text-lg">A practical, trustworthy guide for foreigners in Latvia.</p>
          <button class="bg-[#9E3039] hover:bg-[#7F232B] text-white font-bold py-2.5 px-6 rounded-lg transition-colors shadow-sm focus:ring-4 focus:ring-[#F3E1E3]">
            Get Started
          </button>
        </section>

        <!-- Main Content -->
        <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
          <!-- Cards Section -->
          <div>
            <h3 class="text-2xl font-bold mb-6 text-[#1B2027]">Essential Info</h3>
            <div class="grid grid-cols-2 gap-6">
              <div class="bg-white p-6 rounded-xl shadow-sm border border-[#C9CFD7] hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                  <h4 class="font-bold text-lg text-[#1B2027]">Residence Permits</h4>
                  <span class="bg-[#DBEAFE] border border-[#93C5FD] text-[#1E40AF] text-xs font-bold px-2 py-1 rounded">Verified</span>
                </div>
                <p class="text-[#5A6370] text-sm leading-relaxed mb-4">Learn about the different types of residence permits available for non-EU citizens.</p>
                <a href="#" class="text-[#9E3039] font-medium text-sm hover:underline">Read more &rarr;</a>
              </div>
              
              <div class="bg-white p-6 rounded-xl shadow-sm border border-[#C9CFD7] hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                  <h4 class="font-bold text-lg text-[#1B2027]">PMLP Office</h4>
                  <span class="bg-[#D1FAE5] border border-[#6EE7B7] text-[#065F46] text-xs font-bold px-2 py-1 rounded">Official</span>
                </div>
                <p class="text-[#5A6370] text-sm leading-relaxed mb-4">Official government immigration office details.</p>
                <a href="#" class="text-[#9E3039] font-medium text-sm hover:underline">Read more &rarr;</a>
              </div>
            </div>
          </div>

          <!-- Warning Box & Button States -->
          <div class="grid grid-cols-2 gap-6">
             <div class="bg-[#FFEDD5] border border-[#FDBA74] rounded-xl p-6">
                <div class="flex items-center gap-2 mb-2">
                   <span class="text-[#C2410C] font-bold">Warning</span>
                </div>
                <p class="text-[#9A3412] text-sm">Use Orange/Amber for warnings, not the brand red.</p>
             </div>
             <div class="bg-white border border-[#C9CFD7] rounded-xl p-6 flex flex-col gap-3 justify-center items-center shadow-sm">
                <button class="bg-[#9E3039] px-5 py-2 rounded-lg font-medium w-full text-white">Primary Action</button>
                <button class="bg-white text-[#9E3039] border border-[#9E3039] px-5 py-2 rounded-lg font-medium w-full hover:bg-[#F3E1E3]">Secondary Action</button>
             </div>
          </div>
        </main>

        <!-- Footer -->
        <footer class="bg-[#2E343D] text-[#C9CFD7] py-8 px-6 text-center text-sm">
          <p>&copy; 2026 Latvia Guide. Built with care.</p>
        </footer>
      </div>
    </div>


    <!-- OPTION B -->
