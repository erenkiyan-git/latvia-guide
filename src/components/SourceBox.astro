---
interface Props {
  url?: string;
  date?: string;
  verified?: boolean;
}

const { url, date, verified } = Astro.props;
---

<div class="source-box">
  <div class="source-header">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="source-icon">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
    <strong>Information Source</strong>
  </div>
  
  <div class="source-content">
    {url ? (
      <p>
        Official source: <a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname}</a>
      </p>
    ) : (
      <p>No official source link provided.</p>
    )}
    
    {verified && date ? (
      <p class="verified-date">Last checked: {date}</p>
    ) : (
      <p class="unverified-date">Draft - Not yet verified against official source</p>
    )}
  </div>
</div>

<style>
  .source-box {
    background-color: var(--color-bg);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--spacing-4);
    margin: var(--spacing-6) 0;
  }

  .source-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-2);
    color: var(--color-text);
  }

  .source-icon {
    color: var(--color-primary);
  }

  .source-content {
    font-size: 0.875rem;
  }

  .source-content p {
    margin-bottom: var(--spacing-1);
  }
  
  .source-content p:last-child {
    margin-bottom: 0;
  }

  .verified-date {
    color: var(--color-success);
    font-weight: 500;
  }

  .unverified-date {
    color: var(--color-warning);
    font-weight: 500;
  }
</style>
