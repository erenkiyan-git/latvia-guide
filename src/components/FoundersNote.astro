---
interface Props {
  text?: string;
  lang?: string;
}
const { text, lang = 'en' } = Astro.props;
const isPlaceholder = !text || text.includes('TODO');
const hasContent = Boolean(text && text.trim().length > 0 && !isPlaceholder);
---

{hasContent && (
  <div class="bg-primary-50/60 border-l-4 border-primary-600 p-4 my-6 rounded-r-lg shadow-xs">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-primary-600 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-semibold text-primary-900">
          {lang === 'tr' ? 'Kurucunun Deneyim Notu' : "Founder's Note"}
        </h3>
        <div class="mt-1.5 text-sm text-slate-700 leading-relaxed italic">
          {text}
        </div>
      </div>
    </div>
  </div>
)}

