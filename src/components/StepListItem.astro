---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<li class="mb-8 ml-6 relative">
  <span class="absolute flex items-center justify-center w-8 h-8 bg-surface border-2 border-primary-500 rounded-full -left-10 ring-4 ring-base text-primary-400 font-mono text-xs font-bold shadow-[0_0_10px_rgba(196,52,63,0.3)]">
    <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M1 5.917 5.724 10.5 15 1.5"/>
    </svg>
  </span>
  <h3 class="flex items-center text-lg font-bold text-slate-900 mt-0 mb-2">{title}</h3>
  <div class="text-slate-600 text-sm leading-relaxed">
    <slot />
  </div>
</li>
