---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<li class="mb-10 ml-6">
  <span class="absolute flex items-center justify-center w-8 h-8 bg-blue-100 rounded-full -left-4 ring-4 ring-surface">
    <svg class="w-3.5 h-3.5 text-blue-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5.917 5.724 10.5 15 1.5"/>
    </svg>
  </span>
  <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900 mt-0">{title}</h3>
  <div class="mb-4 text-base font-normal text-gray-600">
    <slot />
  </div>
</li>
