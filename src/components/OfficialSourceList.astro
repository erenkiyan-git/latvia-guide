---
interface Props {
  links: { url: string; title: string; }[];
}
const { links } = Astro.props;
---
<div class="hud-card rounded-lg p-5 my-6 border border-slate-300">
  <div class="flex items-center gap-2 mb-3">
    <span class="inline-block w-2 h-2 bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
    <h3 class="hud-label text-emerald-400 font-bold m-0 tracking-wider">
      // OFFICIAL SOURCES
    </h3>
  </div>
  <ul class="space-y-2.5 m-0 pl-0 list-none">
    {links.map(link => (
      <li class="flex items-start text-sm">
        <svg class="h-4 w-4 text-emerald-400 mr-2.5 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 hover:underline break-all font-medium transition-colors">
          {link.title} &rarr;
        </a>
      </li>
    ))}
  </ul>
</div>
