---
interface Props {
  headers?: string[];
}
const { headers = ["Document", "Who issues it", "Original/copy", "Translation needed?", "Apostille/legalisation?", "Validity / notes", "Type"] } = Astro.props;
---
<div class="overflow-x-auto my-6 hud-card rounded-lg border border-slate-300">
  <table class="min-w-full divide-y divide-slate-300">
    <thead class="bg-slate-100">
      <tr>
        {headers.map(header => (
          <th scope="col" class="py-3 px-4 text-left text-xs font-mono tracking-wider uppercase text-slate-700">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-300/60 bg-surface text-sm text-slate-700">
      <slot />
    </tbody>
  </table>
</div>
