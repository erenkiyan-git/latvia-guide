---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="group bg-white border border-gray-200 rounded-lg my-2 cursor-pointer transition-all duration-200">
  <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-4 text-gray-900 group-hover:text-blue-600">
    <span>{title}</span>
    <span class="transition group-open:rotate-180">
      <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
    </span>
  </summary>
  <div class="text-gray-600 px-4 pb-4 group-open:animate-fadeIn">
    <slot />
  </div>
</details>
<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
