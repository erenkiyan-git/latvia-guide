---
import { useTranslations } from '../i18n/utils';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  type: 'official' | 'verified' | 'draft';
}

const { type } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getBadgeInfo = (badgeType: string) => {
  switch (badgeType) {
    case 'official':
      return { class: 'badge-official', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', text: t('badge.official') };
    case 'verified':
      return { class: 'badge-verified', icon: 'M5 13l4 4L19 7', text: t('badge.verified') };
    case 'draft':
    default:
      return { class: 'badge-draft', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z', text: t('badge.draft') };
  }
};

const info = getBadgeInfo(type);
---

<span class={`trust-badge ${info.class}`}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d={info.icon} />
  </svg>
  {info.text}
</span>

<style>
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-official {
    background-color: var(--color-success-bg);
    color: var(--color-success);
    border: 1px solid var(--color-success);
  }

  .badge-verified {
    background-color: var(--color-primary-light);
    color: var(--color-primary-dark);
    border: 1px solid var(--color-primary);
  }

  .badge-draft {
    background-color: var(--color-warning-bg);
    color: var(--color-warning);
    border: 1px solid var(--color-warning);
  }
</style>
