---
interface Props {
  guides: { slug: string; title: string; description?: string }[];
}
const { guides } = Astro.props;
---
<div class="my-8">
  <h3 class="text-xl font-bold mb-4">Related Guides</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {guides.map(guide => (
      <a href={`./${guide.slug}`} class="block p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-sm transition-all">
        <h4 class="font-semibold text-blue-700 m-0">{guide.title}</h4>
        {guide.description && <p class="text-sm text-gray-600 mt-1 mb-0 line-clamp-2">{guide.description}</p>}
      </a>
    ))}
  </div>
</div>
