---
interface Props {
  guides: { slug: string; title: string; description?: string }[];
}
const { guides } = Astro.props;
---
<div class="my-10">
  <div class="flex items-center gap-2 mb-4">
    <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
    <h3 class="text-lg font-bold font-mono uppercase tracking-wider text-slate-900 m-0">// Related Guides</h3>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {guides.map(guide => (
      <a href={`./${guide.slug}`} class="hud-card hud-hover block p-5 rounded-xl border border-slate-300 hover:border-primary-500/70 transition-all group">
        <h4 class="font-bold text-base text-slate-900 group-hover:text-primary-300 transition-colors m-0">{guide.title}</h4>
        {guide.description && <p class="text-sm text-slate-700 mt-2 mb-0 line-clamp-2 leading-relaxed">{guide.description}</p>}
      </a>
    ))}
  </div>
</div>
