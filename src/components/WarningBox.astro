---
import { AlertTriangle } from 'lucide-react';

interface Props {
  title?: string;
}

const { title = 'Warning' } = Astro.props;
---

<aside class="my-6 not-prose hud-card border-l-4 border-l-amber-500 border border-amber-500/40 bg-surface/95 rounded-xl p-4 sm:p-5 flex gap-4 shadow-xl shadow-black/40" role="alert">
  <div class="flex-shrink-0 mt-0.5">
    <div class="p-2 rounded-lg bg-amber-950/80 border border-amber-600/60 text-amber-400 shadow-sm">
      <AlertTriangle className="w-5 h-5 text-amber-400" />
    </div>
  </div>
  <div class="flex-1 min-w-0">
    {title && (
      <h4 class="text-amber-400 font-bold font-mono text-xs sm:text-sm tracking-wide uppercase mb-1.5 flex items-center gap-1.5">
        <span class="text-amber-500 font-bold">//</span>
        <span>{title}</span>
      </h4>
    )}
    <div class="warning-box-body text-sm sm:text-base leading-relaxed font-normal">
      <slot />
    </div>
  </div>
</aside>

<style is:global>
  .warning-box-body,
  .warning-box-body p,
  .warning-box-body span,
  .warning-box-body li {
    color: #f3f4f6 !important;
    line-height: 1.625 !important;
  }
  .warning-box-body p {
    margin-bottom: 0.75rem !important;
  }
  .warning-box-body p:last-child {
    margin-bottom: 0 !important;
  }
  .warning-box-body strong {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
  .warning-box-body a {
    color: #fbbf24 !important;
    text-decoration: underline !important;
    font-weight: 600 !important;
  }
  .warning-box-body a:hover {
    color: #fde68a !important;
  }
  .warning-box-body code {
    background: #1e222b !important;
    color: #fde68a !important;
    padding: 0.15rem 0.35rem !important;
    border-radius: 4px !important;
  }
</style>
