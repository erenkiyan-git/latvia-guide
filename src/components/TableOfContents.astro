---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: HeadingItem[];
  headers?: HeadingItem[];
  lang?: string;
  variant?: 'mobile' | 'desktop' | 'both';
}

const { headings, headers, lang = 'en', variant = 'both' } = Astro.props;

const rawList = headings || headers || [];
const toc = rawList.filter(h => (h.depth === 2 || h.depth === 3) && h.slug && h.text);

const title = lang === 'tr' ? 'Bu Sayfada' : 'On this page';
const tocLabel = lang === 'tr' ? 'İçindekiler' : 'Table of Contents';
const countSuffix = lang === 'tr' ? 'bölüm' : 'sections';
---

{toc.length >= 3 && (
  <>
    {/* Mobile & Tablet Collapsible Accordion (Hidden on xl screens where the sticky rail is visible) */}
    {(variant === 'mobile' || variant === 'both') && (
      <aside class="toc-mobile-container xl:hidden my-6 not-prose" aria-label={tocLabel}>
        <details class="group bg-surface/85 hover:bg-surface border border-slate-300 rounded-xl p-3.5 sm:p-4 shadow-sm backdrop-blur-sm transition-all">
          <summary class="flex items-center justify-between cursor-pointer list-none select-none font-semibold text-slate-900 text-sm focus:outline-none">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="p-1 rounded-md bg-primary-100 text-primary-700">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
              </span>
              <span class="font-bold">{title}</span>
              <span class="text-xs font-mono font-normal text-slate-500">
                ({toc.length} {countSuffix})
              </span>
            </div>
            <svg 
              class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <nav class="mt-3.5 pt-3 border-t border-slate-200/80">
            <ul class="space-y-1.5 text-xs sm:text-sm list-none pl-0 m-0">
              {toc.map(item => (
                <li class={item.depth === 3 ? 'pl-4 border-l border-slate-200 ml-1' : ''}>
                  <a 
                    href={`#${item.slug}`}
                    data-toc-target={item.slug}
                    class="toc-mobile-link flex items-center justify-between py-1 px-2 rounded-lg text-slate-700 hover:text-primary-600 hover:bg-slate-100 transition-colors"
                  >
                    <span class="truncate">{item.text}</span>
                    <span class="text-primary-400 font-mono text-xs opacity-0 hover:opacity-100 transition-opacity">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </aside>
    )}

    {/* Desktop Sticky Floating Rail */}
    {(variant === 'desktop' || variant === 'both') && (
      <aside 
        class="toc-desktop-container hidden xl:block w-56 2xl:w-64 shrink-0 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto pr-1 not-prose"
        aria-label={title}
      >
        <div class="p-4 rounded-2xl bg-surface/80 border border-slate-300/80 backdrop-blur-sm shadow-sm">
          <div class="flex items-center gap-2 mb-3.5 pb-2 border-b border-slate-200 text-xs font-mono font-bold uppercase tracking-wider text-slate-600">
            <span class="w-1.5 h-1.5 rounded-full bg-primary-500 animate-pulse"></span>
            <span>{title}</span>
            <span class="text-[0.65rem] text-slate-400 font-normal ml-auto">({toc.length})</span>
          </div>
          <nav class="toc-desktop-nav">
            <ul class="space-y-1 text-xs list-none pl-0 m-0">
              {toc.map(item => (
                <li class={item.depth === 3 ? 'pl-3' : ''}>
                  <a 
                    href={`#${item.slug}`}
                    data-toc-target={item.slug}
                    class="toc-desktop-link block py-1.5 px-2.5 rounded-lg text-slate-600 hover:text-primary-600 hover:bg-slate-100 transition-all leading-snug border-l-2 border-transparent text-left"
                    title={item.text}
                  >
                    <span class="line-clamp-2">{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
  </>
)}

<script>
  function setupTableOfContents() {
    const headings = Array.from(document.querySelectorAll('.guide-content h2[id], .guide-content h3[id]'));
    if (headings.length === 0) return;

    const desktopLinks = Array.from(document.querySelectorAll('.toc-desktop-link'));
    const mobileLinks = Array.from(document.querySelectorAll('.toc-mobile-link'));
    const allLinks = [...desktopLinks, ...mobileLinks];

    // Smooth click handler
    allLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-toc-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#${targetId}`);
        }
      });
    });

    // Active heading tracking with IntersectionObserver
    let activeId = '';
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activeId = entry.target.id;
          highlightActive(activeId);
        }
      });
    }, {
      rootMargin: '-80px 0% -65% 0%',
      threshold: 0
    });

    headings.forEach(h => observer.observe(h));

    function highlightActive(id: string) {
      if (!id) return;
      desktopLinks.forEach(link => {
        const target = link.getAttribute('data-toc-target');
        if (target === id) {
          link.classList.add('text-primary-600', 'font-semibold', 'bg-primary-50', 'border-primary-500');
          link.classList.remove('text-slate-600', 'border-transparent');
        } else {
          link.classList.remove('text-primary-600', 'font-semibold', 'bg-primary-50', 'border-primary-500');
          link.classList.add('text-slate-600', 'border-transparent');
        }
      });

      mobileLinks.forEach(link => {
        const target = link.getAttribute('data-toc-target');
        if (target === id) {
          link.classList.add('text-primary-600', 'font-semibold', 'bg-primary-50');
          link.classList.remove('text-slate-700');
        } else {
          link.classList.remove('text-primary-600', 'font-semibold', 'bg-primary-50');
          link.classList.add('text-slate-700');
        }
      });
    }
  }

  // Run on page load and client navigations
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTableOfContents);
  } else {
    setupTableOfContents();
  }
  document.addEventListener('astro:page-load', setupTableOfContents);
</script>
