---
interface Props {
  headers: { depth: number; slug: string; text: string }[];
}
const { headers } = Astro.props;
// Filter only H2 and H3
const toc = headers.filter(h => h.depth === 2 || h.depth === 3);
---
{toc.length > 0 && (
  <div class="bg-gray-50 p-4 rounded-lg my-6 max-w-sm hidden md:block float-right ml-6 mb-6">
    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3 mt-0">On this page</h3>
    <ul class="space-y-2 m-0 pl-0 list-none text-sm">
      {toc.map(header => (
        <li class={`${header.depth === 3 ? 'ml-4' : ''}`}>
          <a href={`#${header.slug}`} class="text-gray-600 hover:text-blue-600">
            {header.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
