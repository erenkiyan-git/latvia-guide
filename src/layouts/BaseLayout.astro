---
import '@fontsource/inter';
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { getActiveLanguages, useTranslations } from '../i18n/utils';
import { LANGUAGES } from '../config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'A practical, trustworthy guide for foreigners in Latvia.', lang = 'en' } = Astro.props;

const activeLangs = getActiveLanguages();
const t = useTranslations(lang as any);

const langLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([key, val]) => [key, val.label])
);

const navLinks = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/map/`, label: t('nav.map') },
  { href: `/${lang}/useful-websites/`, label: t('nav.websites') }
];

const footerLinks = [
  { href: `/${lang}/about/`, label: 'About & Trust' },
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/checklist/`, label: lang === 'tr' ? '30 Günlük Kontrol Listesi' : '30-Day Checklist' },
  { href: `/${lang}/calculators/salary/`, label: lang === 'tr' ? 'Net Maaş Hesaplayıcı' : 'Net Salary Calculator' },
  { href: `/${lang}/calculators/living-costs/`, label: lang === 'tr' ? 'Yaşam Maliyeti Hesaplayıcı' : 'Living Costs Calculator' },
  { href: `/${lang}/useful-websites/`, label: lang === 'tr' ? 'Faydalı Web Siteleri' : 'Useful Websites' },
  { href: `/${lang}/phrases/`, label: lang === 'tr' ? 'Letonca İfadeler' : 'Latvian Phrases' },
  { href: `/${lang}/emergency/`, label: lang === 'tr' ? 'Acil Durum' : 'Emergency Contacts', isEmergency: true }
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Latvia Guide</title>
    <meta name="title" content={`${title} | Latvia Guide`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Latvia Guide`} />
    <meta property="og:description" content={description} />
    <!-- Placeholder for actual social image -->
    <meta property="og:image" content="https://latviaguide.com/social-card.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | Latvia Guide`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://latviaguide.com/social-card.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Analytics Placeholder -->
    <script is:inline>
      // window.dataLayer = window.dataLayer || [];
      // function gtag(){dataLayer.push(arguments);}
      // gtag('js', new Date());
      // gtag('config', 'G-XXXXXXXXXX');
    </script>
  </head>
  <body className="flex flex-col min-h-screen bg-slate-50 text-slate-800 selection:bg-primary-200 selection:text-primary-900">
    <Header 
      client:load 
      currentLang={lang} 
      activeLangs={activeLangs} 
      langLabels={langLabels} 
      navLinks={navLinks} 
      logoText="Latvia Guide" 
    />
    
    <main className="flex-1 py-8">
      <slot />
    </main>
    
    <Footer 
      currentLang={lang} 
      subtitle={t('hero.subtitle')} 
      disclaimer={t('footer.disclaimer')} 
      links={footerLinks} 
    />
  </body>
</html>
