---
import '@fontsource/inter';
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { getActiveLanguages, useTranslations } from '../i18n/utils';
import { LANGUAGES } from '../config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'A practical, trustworthy guide for foreigners in Latvia.', lang = 'en' } = Astro.props;

const activeLangs = getActiveLanguages();
const t = useTranslations(lang as any);

const langLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([key, val]) => [key, val.label])
);

const navLinks = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/map/`, label: t('nav.map') },
  { href: `/${lang}/useful-websites/`, label: t('nav.websites') }
];

const footerLinks = [
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/checklist/`, label: t('footer.checklist') },
  { href: `/${lang}/map/`, label: t('nav.map') },
  { href: `/${lang}/calculators/salary/`, label: t('footer.salary') },
  { href: `/${lang}/useful-websites/`, label: t('footer.usefulWebsites') },
  { href: `/${lang}/phrases/`, label: t('footer.phrases') },
  { href: `/${lang}/emergency/`, label: t('footer.emergency'), isEmergency: true }
];

const legalLinks = [
  { href: `/${lang}/about/`, label: t('nav.about') },
  { href: `/${lang}/privacy/`, label: t('footer.privacy') },
  { href: `/${lang}/cookies/`, label: t('footer.cookies') },
  { href: `/${lang}/terms/`, label: t('footer.terms') }
];

const siteUrl = 'https://latviaguide.com';
const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalUrl = new URL(cleanPath, siteUrl).toString();

// Generate hreflang alternates for multilingual pages
let enHref: string | null = null;
let trHref: string | null = null;
let xDefaultHref: string | null = null;

if (pathname.startsWith('/en/') || pathname.startsWith('/tr/')) {
  enHref = new URL(cleanPath.replace(/^\/(en|tr)\//, '/en/'), siteUrl).toString();
  trHref = new URL(cleanPath.replace(/^\/(en|tr)\//, '/tr/'), siteUrl).toString();
  xDefaultHref = enHref;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Latvia Guide</title>
    <meta name="title" content={`${title} | Latvia Guide`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical & Hreflang Alternates -->
    <link rel="canonical" href={canonicalUrl} />
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {trHref && <link rel="alternate" hreflang="tr" href={trHref} />}
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Latvia Guide`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://latviaguide.com/social-card.jpg" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta property="og:site_name" content="Latvia Guide" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | Latvia Guide`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://latviaguide.com/social-card.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0c0f" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex flex-col min-h-screen">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-primary-600 focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-white"
    >
      {lang === 'tr' ? 'Ana içeriğe atla' : 'Skip to main content'}
    </a>
    <Header 
      client:load 
      currentLang={lang} 
      activeLangs={activeLangs} 
      langLabels={langLabels} 
      navLinks={navLinks} 
      logoText="Latvia Guide" 
    />
    
    <main id="main-content" class="flex-1 py-8">
      <slot />
    </main>
    
    <Footer 
      currentLang={lang} 
      subtitle={t('hero.subtitle')} 
      disclaimer={t('footer.disclaimer')} 
      links={footerLinks}
      legalLinks={legalLinks}
      legalHeading={t('footer.legal')}
    />
  </body>
</html>
