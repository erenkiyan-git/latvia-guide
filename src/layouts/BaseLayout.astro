---
import '@fontsource/inter';
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { getActiveLanguages, useTranslations } from '../i18n/utils';
import { LANGUAGES } from '../config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'A practical, trustworthy guide for foreigners in Latvia.', lang = 'en' } = Astro.props;

const activeLangs = getActiveLanguages();
const t = useTranslations(lang as any);

const langLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([key, val]) => [key, val.label])
);

const navLinks = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/map/`, label: t('nav.map') },
  { href: `/${lang}/useful-websites/`, label: t('nav.websites') }
];

const footerLinks = [
  { href: `/${lang}/guides/`, label: t('nav.guides') },
  { href: `/${lang}/checklist/`, label: t('footer.checklist') },
  { href: `/${lang}/map/`, label: t('nav.map') },
  { href: `/${lang}/calculators/salary/`, label: t('footer.salary') },
  { href: `/${lang}/useful-websites/`, label: t('footer.usefulWebsites') },
  { href: `/${lang}/phrases/`, label: t('footer.phrases') },
  { href: `/${lang}/emergency/`, label: t('footer.emergency'), isEmergency: true }
];

const legalLinks = [
  { href: `/${lang}/about/`, label: t('nav.about') },
  { href: `/${lang}/privacy/`, label: t('footer.privacy') },
  { href: `/${lang}/cookies/`, label: t('footer.cookies') },
  { href: `/${lang}/terms/`, label: t('footer.terms') }
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Latvia Guide</title>
    <meta name="title" content={`${title} | Latvia Guide`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Latvia Guide`} />
    <meta property="og:description" content={description} />
    <!-- Placeholder for actual social image -->
    <meta property="og:image" content="https://latviaguide.com/social-card.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | Latvia Guide`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://latviaguide.com/social-card.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    
  </head>
  <body class="flex flex-col min-h-screen">
    <Header 
      client:load 
      currentLang={lang} 
      activeLangs={activeLangs} 
      langLabels={langLabels} 
      navLinks={navLinks} 
      logoText="Latvia Guide" 
    />
    
    <main class="flex-1 py-8">
      <slot />
    </main>
    
    <Footer 
      currentLang={lang} 
      subtitle={t('hero.subtitle')} 
      disclaimer={t('footer.disclaimer')} 
      links={footerLinks}
      legalLinks={legalLinks}
      legalHeading={t('footer.legal')}
    />
  </body>
</html>
