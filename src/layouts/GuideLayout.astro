---
import BaseLayout from './BaseLayout.astro';
import GuidesSidebar from '../components/GuidesSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { Breadcrumbs } from '../components/ui/Breadcrumbs';
import { TrustBadge } from '../components/ui/TrustBadge';
import { SourceBox } from '../components/ui/SourceBox';
import { WarningBox } from '../components/ui/WarningBox';
import { Languages, ArrowRight, CheckCircle2, Bookmark } from 'lucide-react';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations, getSectionName } from '../i18n/utils';
import { SITE } from '../config';

interface Props {
  guide: CollectionEntry<'guides'>;
  isFallback?: boolean;
  currentLang?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { guide, isFallback = false, currentLang, headings = [] } = Astro.props;
const { title, description, badge, officialSource, lastChecked, verified, section } = guide.data;
const lang = currentLang || guide.id.split('/')[0];
const t = useTranslations(lang as any);
const guideSlug = guide.id.split('/').slice(1).join('/');

const breadcrumbsItems = [
  { label: t('breadcrumbs.home'), href: `/${lang}/` },
  { label: t('breadcrumbs.guides'), href: `/${lang}/guides/` },
  { label: getSectionName(section, lang as any), href: `/${lang}/guides/${section}/` },
  { label: title }
];

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://latviaguide.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbsItems.map((item, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': item.label,
    'item': item.href ? new URL(item.href, siteUrl).toString() : currentUrl
  }))
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'inLanguage': lang,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': currentUrl
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Latvia Guide',
    'url': siteUrl,
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteUrl}/favicon.svg`
    }
  },
  'author': {
    '@type': 'Organization',
    'name': 'Latvia Guide Editorial Team'
  },
  ...(verified && lastChecked ? { 'dateModified': lastChecked } : {})
};

const allGuides = await getCollection('guides');
const currentSlug = guide.id.split('/').slice(1).join('/');

const sameSectionGuides = allGuides.filter(g => {
  const gLang = g.id.split('/')[0];
  const gSlug = g.id.split('/').slice(1).join('/');
  return gLang === lang && g.data.section === section && gSlug !== currentSlug;
});

let related = [...sameSectionGuides];
if (related.length < 2) {
  const enSameSection = allGuides.filter(g => {
    const gLang = g.id.split('/')[0];
    const gSlug = g.id.split('/').slice(1).join('/');
    return gLang === 'en' && g.data.section === section && gSlug !== currentSlug && !related.some(r => r.id.split('/').slice(1).join('/') === gSlug);
  });
  related = [...related, ...enSameSection];
}

const relatedGuides = related.slice(0, 3).map(g => {
  const gSlug = g.id.split('/').slice(1).join('/');
  return {
    title: g.data.title,
    description: g.data.description,
    href: `/${lang}/guides/${gSlug}/`,
    badge: g.data.badge
  };
});

interface NextStepCallout {
  titleEn: string;
  titleTr: string;
  descEn: string;
  descTr: string;
  actionEn: string;
  actionTr: string;
  href: string;
}

const nextStepRules: Record<string, NextStepCallout> = {
  'documents': {
    titleEn: 'Next Step: Declare Your Address (deklarēšanās)',
    titleTr: 'Sonraki Adım: İkamet Beyanı (deklarēšanās)',
    descEn: 'After receiving your residence permit, Latvian law requires declaring your address within 30 days.',
    descTr: 'Oturum izninizi aldıktan sonra Letonya yasalarına göre 30 gün içinde adres beyanında bulunmanız zorunludur.',
    actionEn: 'Read Address Declaration Guide',
    actionTr: 'İkamet Beyanı Rehberini Oku',
    href: `/${lang}/guides/documents/address-declaration/`
  },
  'housing': {
    titleEn: 'Next Step: Estimate Total Monthly Living Costs',
    titleTr: 'Sonraki Adım: Aylık Yaşam Masraflarınızı Planlayın',
    descEn: 'Calculate rent, winter heating, utilities, and grocery expenses in Riga.',
    descTr: 'Riga\'daki kira, kış ısınma faturaları, aidat ve mutfak masraflarınızı hesaplayın.',
    actionEn: 'Open Living Costs Calculator',
    actionTr: 'Yaşam Maliyeti Hesaplayıcıyı Aç',
    href: `/${lang}/calculators/living-costs/`
  },
  'work': {
    titleEn: 'Next Step: Calculate Your Net Take-Home Salary',
    titleTr: 'Sonraki Adım: Net Maaşınızı Hesaplayın',
    descEn: 'Calculate your exact net salary after Latvian income taxes (IIN) and social security contributions (VSAOI).',
    descTr: 'Letonya gelir vergisi (IIN) ve sosyal sigorta (VSAOI) kesintileri sonrası elinize geçecek net maaşı görün.',
    actionEn: 'Open Net Salary Calculator',
    actionTr: 'Maaş Hesaplayıcıyı Aç',
    href: `/${lang}/calculators/salary/`
  },
  'healthcare': {
    titleEn: 'Next Step: Locate Nearby Hospitals & Emergency Care',
    titleTr: 'Sonraki Adım: En Yakın Hastaneleri ve Acil Servisleri Görün',
    descEn: 'Find verified emergency care hospitals, clinics, and pharmacies on our interactive map.',
    descTr: 'Doğrulanmış acil servisleri, poliklinikleri ve eczaneleri interaktif haritamızda inceleyin.',
    actionEn: 'Open Places Map',
    actionTr: 'Haritayı Aç',
    href: `/${lang}/map/`
  },
  'students': {
    titleEn: 'Next Step: Track Your First Month Checklist',
    titleTr: 'Sonraki Adım: İlk Ay Kontrol Listenizi Takip Edin',
    descEn: 'Step-by-step checklist for university registration, ISIC student card, and public transport discount.',
    descTr: 'Üniversite kaydı, ISIC öğrenci kartı ve indirimli ulaşım adımlarını kontrol listemizle tamamlayın.',
    actionEn: 'Open 30-Day Checklist',
    actionTr: '30 Günlük Listeyi Aç',
    href: `/${lang}/checklist/`
  }
};

const defaultNextStep: NextStepCallout = {
  titleEn: 'Next Step: Follow the 30-Day Relocation Checklist',
  titleTr: 'Sonraki Adım: 30 Günlük Kontrol Listesini Takip Edin',
  descEn: 'Track your vital relocation milestones step-by-step so you never miss an official deadline.',
  descTr: 'Resmi süreleri ve randevuları kaçırmamak için ilk ay yapılması gerekenleri adım adım takip edin.',
  actionEn: 'Open Checklist',
  actionTr: 'Kontrol Listesini Aç',
  href: `/${lang}/checklist/`
};

const activeNextStep = nextStepRules[section] || defaultNextStep;
---

<BaseLayout title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 flex flex-col lg:flex-row gap-6 lg:gap-8">
  <GuidesSidebar lang={lang} activeSection={section} activeSlug={guideSlug} />
  <article class="flex-1 min-w-0 max-w-3xl">
    <Breadcrumbs items={breadcrumbsItems} />

    {isFallback && (
      <div class="my-6 hud-card border-l-4 border-l-amber-500 border border-amber-900/40 bg-surface/90 rounded-2xl p-5 sm:p-6 shadow-xl">
        <div class="flex items-start gap-4">
          <div class="p-2.5 bg-amber-950/60 border border-amber-800/50 rounded-xl text-amber-400 shrink-0 mt-0.5">
            <Languages class="w-5 h-5" />
          </div>
          <div class="flex-grow">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="text-[0.65rem] font-mono font-bold uppercase tracking-wider bg-amber-950/80 text-amber-300 border border-amber-700/60 px-2.5 py-0.5 rounded-full">
                {t('guide.fallbackBadge')}
              </span>
              <h3 class="font-bold text-base text-slate-900">
                {t('guide.fallbackTitle')}
              </h3>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed">
              {t('guide.fallbackDesc')}
            </p>
            <div class="mt-2.5 text-xs">
              <a href={`mailto:${SITE.contactEmail}?subject=Translation assistance for: ${title}`} class="text-amber-400 font-semibold underline hover:text-amber-300 transition-colors">
                {t('guide.fallbackAction')} &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <header class="mb-10 sm:mb-12">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <TrustBadge type={badge} lang={lang} />
        {verified && lastChecked && (
          <span class="text-xs text-slate-500 font-mono tracking-wide">
            {lang === 'tr' ? 'Son kontrol:' : 'Last checked:'} {lastChecked}
          </span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl leading-relaxed">
        {description}
      </p>
    </header>

    {officialSource && (
      <div class="mb-10">
        <SourceBox url={officialSource} label={t('guide.officialSource')} />
      </div>
    )}

    {/* Mobile & Tablet Collapsible Table of Contents */}
    <TableOfContents headings={headings} lang={lang} variant="mobile" />

    <div class="guide-content prose prose-slate max-w-none 
      prose-headings:text-slate-900 prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-24
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-300
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
      prose-p:text-slate-700 prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-primary-400 prose-a:font-semibold prose-a:underline hover:prose-a:text-primary-300
      prose-strong:text-slate-900 prose-strong:font-semibold
      prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-6 prose-ul:text-slate-700
      prose-ol:list-decimal prose-ol:pl-6 prose-ol:mb-6 prose-ol:text-slate-700
      prose-li:mb-2 prose-li:marker:text-slate-500
      prose-blockquote:border-l-4 prose-blockquote:border-l-primary-600 prose-blockquote:bg-surface prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:rounded-r-xl prose-blockquote:text-slate-700 prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:shadow-sm
      ">
      <slot />
    </div>

    {/* Recommended Next Step Callout */}
    <div class="my-10 bg-gradient-to-br from-primary-950/20 via-surface to-surface border border-primary-500/40 rounded-2xl p-6 sm:p-7 shadow-md">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
        <div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[0.65rem] font-bold uppercase tracking-wider bg-primary-100 text-primary-900 border border-primary-200 mb-2">
            <CheckCircle2 class="w-3.5 h-3.5 text-primary-600" />
            {lang === 'tr' ? 'Önerilen Sonraki Adım' : 'Recommended Next Step'}
          </span>
          <h3 class="text-xl font-bold text-slate-900 mb-1">
            {lang === 'tr' ? activeNextStep.titleTr : activeNextStep.titleEn}
          </h3>
          <p class="text-slate-600 text-sm max-w-xl leading-relaxed">
            {lang === 'tr' ? activeNextStep.descTr : activeNextStep.descEn}
          </p>
        </div>
        <a 
          href={activeNextStep.href} 
          class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-primary-600 hover:bg-primary-700 text-white transition-colors shadow-sm"
        >
          <span>{lang === 'tr' ? activeNextStep.actionTr : activeNextStep.actionEn}</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>

    {/* Related Guides Component */}
    {relatedGuides.length > 0 && (
      <div class="my-12">
        <h3 class="text-xl font-bold text-slate-900 mb-5 flex items-center gap-2">
          <Bookmark class="w-5 h-5 text-primary-500" />
          {lang === 'tr' ? 'İlgili Rehberler' : 'Related Guides'}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedGuides.map((rel) => (
            <a 
              href={rel.href} 
              class="group bg-surface border border-slate-300 hover:border-primary-500 rounded-xl p-4 flex flex-col justify-between transition-all hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between gap-1 mb-2">
                  <TrustBadge type={rel.badge} lang={lang} />
                </div>
                <h4 class="font-bold text-slate-900 text-sm group-hover:text-primary-600 transition-colors leading-snug mb-1">
                  {rel.title}
                </h4>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {rel.description}
                </p>
              </div>
              <div class="mt-3 pt-2 border-t border-slate-200/80 flex items-center justify-end text-xs font-semibold text-primary-600 group-hover:translate-x-0.5 transition-transform gap-1">
                <span>{lang === 'tr' ? 'Rehberi Oku' : 'Read guide'}</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Quick Tools Navigation Strip */}
    <div class="my-8 p-4 bg-slate-100 rounded-2xl border border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
      <span class="font-semibold text-slate-700">
        {lang === 'tr' ? 'Hızlı Araçlar:' : 'Quick Tools:'}
      </span>
      <div class="flex flex-wrap items-center gap-2">
        <a href={`/${lang}/checklist/`} class="px-3 py-1 rounded-lg bg-surface border border-slate-300 hover:border-primary-500 text-slate-700 hover:text-primary-600 transition-colors">
          📋 {lang === 'tr' ? '30 Günlük Liste' : '30-Day Checklist'}
        </a>
        <a href={`/${lang}/map/`} class="px-3 py-1 rounded-lg bg-surface border border-slate-300 hover:border-primary-500 text-slate-700 hover:text-primary-600 transition-colors">
          📍 {lang === 'tr' ? 'Yerler Haritası' : 'Places Map'}
        </a>
        <a href={`/${lang}/calculators/salary/`} class="px-3 py-1 rounded-lg bg-surface border border-slate-300 hover:border-primary-500 text-slate-700 hover:text-primary-600 transition-colors">
          💶 {lang === 'tr' ? 'Net Maaş' : 'Salary Calculator'}
        </a>
        <a href={`/${lang}/calculators/living-costs/`} class="px-3 py-1 rounded-lg bg-surface border border-slate-300 hover:border-primary-500 text-slate-700 hover:text-primary-600 transition-colors">
          🏠 {lang === 'tr' ? 'Yaşam Maliyeti' : 'Living Costs'}
        </a>
        <a href={`/${lang}/emergency/`} class="px-3 py-1 rounded-lg bg-rose-50 border border-rose-200 hover:border-rose-300 text-rose-800 font-medium transition-colors">
          🚨 {lang === 'tr' ? 'Acil Durum (112)' : 'Emergency (112)'}
        </a>
      </div>
    </div>

    <footer class="mt-12 pt-6 border-t border-slate-300 text-right">
      <a href={`mailto:${SITE.contactEmail}?subject=Error in guide: ${title}`} class="text-sm text-slate-500 hover:text-primary-400 hover:underline transition-colors">
        {t('guide.spotError')}
      </a>
    </footer>
  </article>

  {/* Desktop Floating/Sticky Table of Contents */}
  <TableOfContents headings={headings} lang={lang} variant="desktop" />
  </div>
</BaseLayout>

