---
import BaseLayout from './BaseLayout.astro';
import { Breadcrumbs } from '../components/ui/Breadcrumbs';
import { TrustBadge } from '../components/ui/TrustBadge';
import { SourceBox } from '../components/ui/SourceBox';
import { WarningBox } from '../components/ui/WarningBox';
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { title, description, badge, officialSource, lastChecked, verified, section } = guide.data;
const lang = guide.id.split('/')[0];

const formatSectionName = (name: string) => {
  return name.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};

const breadcrumbsItems = [
  { label: 'Home', href: `/${lang}/` },
  { label: 'Guides', href: `/${lang}/guides/` },
  { label: formatSectionName(section), href: `/${lang}/guides/${section}/` },
  { label: title }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbsItems} />

    <header class="mb-10 sm:mb-12">
      <div class="mb-4">
        <TrustBadge type={badge} />
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      <p class="text-lg sm:text-xl text-zinc-400 max-w-2xl leading-relaxed">
        {description}
      </p>
    </header>

    {officialSource && (
      <div class="mb-10">
        <SourceBox url={officialSource} label="Official Information Source" />
      </div>
    )}

    <div class="guide-content prose prose-invert prose-zinc max-w-none 
      prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-zinc-800
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
      prose-p:text-zinc-300 prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-primary-400 prose-a:no-underline hover:prose-a:text-primary-300 hover:prose-a:underline
      prose-strong:text-white prose-strong:font-semibold
      prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-6 prose-ul:text-zinc-300
      prose-ol:list-decimal prose-ol:pl-6 prose-ol:mb-6 prose-ol:text-zinc-300
      prose-li:mb-2 prose-li:marker:text-zinc-500
      prose-blockquote:border-l-primary-500 prose-blockquote:bg-zinc-900 prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:rounded-r-xl prose-blockquote:text-zinc-300 prose-blockquote:font-normal prose-blockquote:not-italic
      ">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-zinc-800 text-right">
      <a href={`mailto:hello@latviaguide.example.com?subject=Error in guide: ${title}`} class="text-sm text-zinc-500 hover:text-primary-400 hover:underline transition-colors">
        Spot an error? Tell us
      </a>
    </footer>
  </article>
</BaseLayout>
